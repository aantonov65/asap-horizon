        {
          "type": "product_card",
          "settings": {
            "variant": "red",
            "title": "Zero Sugar Apple Cider<br>Vinegar+ Gummies",
            "copy": "Our flagship formula, now with zero sugar. Includes Apple Cider Vinegar, Vitamin B12, and SNZ Tribac® probiotics to help support digestion, reduce occasional bloating, and promote energy metabolism, immune function, and overall wellness.",
            "support_label": "Helps support:",
            "support_1": "Digestive Health & Bloating",
            "support_2": "Energy Metabolism",
            "support_3": "Immune Function",
            "image_files": "product-acv-1.png,product-acv-2.jpg,product-acv-3.png,product-acv-4.png,product-acv-5.png,product-acv-6.png"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "variant": "green",
            "title": "Zero Sugar<br>Pre+Post+Probiotics Gummies",
            "copy": "The world’s first 3-in-1 gummy with prebiotics (XOS), probiotics (DE111®), and postbiotics (MCC1849) — all in a zero sugar format. Helps support digestion, gut flora balance, immune health, and daily digestive well-being.",
            "support_label": "Helps support:",
