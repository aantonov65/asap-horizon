{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}

<section class="lzy-goli-benefits" style="--lzy-bg: {{ section.settings.background_color }}; --lzy-text: {{ section.settings.text_color }};">
  <div class="lzy-goli-benefits__inner">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.body | newline_to_br }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Goli Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why You’ll Love This Bundle"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Three powerful formulas. Zero sugar. One clean routine to support digestion, stress relief, and immune health — every day, without compromise."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#d32630"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Goli Benefits"
    }
  ]
}
{% endschema %}
