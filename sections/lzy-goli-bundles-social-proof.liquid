<section id="shopify-section-template--18893871677636__social_images_aam" class="shopify-section section-brand-aam-social-proof"><section class="text-[1vw] pt-[5em] 2xl:text-[1rem]">
  <div><div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-6 2xl:grid-cols-[17em,17em,17em,17em,17em,17em] justify-center">
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        {% assign social_image = block.settings.image_url %}
        {% if block.settings.image != blank %}{% assign social_image = block.settings.image | image_url: width: 600 %}{% endif %}
        <div class="social-image-item" {{ block.shopify_attributes }}><img src="{{ social_image }}" alt="{{ block.settings.alt | escape }}" class="w-full object-cover" loading="lazy" width="1" height="1"></div>
      {% endif %}
    {% endfor %}
  </div></div>
</section></section>

{% schema %}
{
  "name": "Goli Bundles Social Proof",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Fallback image URL",
          "default": "https://goli.com/cdn/shop/files/zs-5.jpg?v=1753812801"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Social proof image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Goli Bundles Social Proof"
    }
  ]
}
{% endschema %}
