{{ 'heresy-shared.css' | asset_url | stylesheet_tag }}
{{ 'heresy-summer-routine.css' | asset_url | stylesheet_tag }}
<script src="{{ 'heresy-summer-routine.js' | asset_url }}" defer></script>

<div data-heresy-section="{{ section.id }}">
<section class="heresy-summer-routine Slider-with-navigation Section" data-heresy-routine>
  <div class="Slider-with-navigation-wrapper reverse-grid">
    <div class="Slider-with-navigation-content">
      <div>
        <h2 class="u-hSize u-noMargin">{{ section.settings.heading }}</h2>
        <div class="heresy-summer-routine__subheading">{{ section.settings.subheading }}</div>
      </div>
      <div class="heresy-summer-routine__swatch-slides" aria-live="polite">
        {% for block in section.blocks %}
          {% assign fallback_asset = block.settings.fallback | prepend: 'heresy-routine-' | append: '-swatch.png' %}
          <div class="Slider-with-navigation-content-image{% if forloop.first %} heresy-is-active{% endif %}" data-heresy-routine-swatch="{{ forloop.index0 }}">
            {% if block.settings.product != blank %}<a href="{{ block.settings.product.url }}">{% endif %}
            <span class="Image Image--desktop o-placeholder bg-full-height skip-animation">
              {% render 'heresy-responsive-image', image: block.settings.swatch_image, fallback_asset: fallback_asset, alt: block.settings.swatch_alt, class: 'skip-animation heresy-summer-routine__swatch-image', width: 600, height: 600 %}
            </span>
            <div class="Slider-with-navigation-content-image-content">
              <p class="u-pSize u-bold u-noMargin">{{ block.settings.product_name }}</p>
              <span class="divider"></span>
              <div class="u-pSize__Small u-noMargin">{{ block.settings.description }}</div>
            </div>
            {% if block.settings.product != blank %}</a>{% endif %}
          </div>
        {% endfor %}
      </div>
      <div class="Slider-with-navigation-content-navigation">
        {% for block in section.blocks %}
          <button type="button" class="Slider-with-navigation-content-navigation-item{% if forloop.first %} Slider-with-navigation-content-navigation-item__active{% endif %}" data-heresy-routine-go="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
            <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="Slider-with-navigation-content-navigation-item-label">{{ block.settings.navigation_label }}</span>
          </button>
        {% endfor %}
      </div>
    </div>
    <div class="Slider-with-navigation-images-container">
      <div class="heresy-summer-routine__model-slides">
        {% for block in section.blocks %}
          {% assign fallback_asset = block.settings.fallback | prepend: 'heresy-routine-' | append: '-model.jpg' %}
          <div class="Slider-with-navigation-image-container{% if forloop.first %} heresy-is-active{% endif %}" data-heresy-routine-model="{{ forloop.index0 }}">
            <span class="Image Image--desktop o-placeholder bg-full-height">
              {% render 'heresy-responsive-image', image: block.settings.model_image, fallback_asset: fallback_asset, alt: block.settings.model_alt, class: 'heresy-summer-routine__model-image', width: 1320, height: 1440 %}
            </span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Heresy summer routine",
  "settings": [
    {"type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The rhode SUMMER ’26 routine."},
    {"type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Hailey’s must-haves for a sun-kissed and luminous look.</p>"}
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Routine step",
      "settings": [
        {"type": "product", "id": "product", "label": "Product"},
        {"type": "text", "id": "navigation_label", "label": "Navigation label", "default": "HIGHLIGHT"},
        {"type": "text", "id": "product_name", "label": "Product name", "default": "highlight milk"},
        {"type": "richtext", "id": "description", "label": "Description", "default": "<p>apply to bare skin or mix with foundation for a natural, pearly glow</p>"},
        {"type": "image_picker", "id": "swatch_image", "label": "Swatch image"},
        {"type": "text", "id": "swatch_alt", "label": "Swatch alt text", "default": "Product swatch"},
        {"type": "image_picker", "id": "model_image", "label": "Model image"},
        {"type": "text", "id": "model_alt", "label": "Model alt text", "default": "Model wearing product"},
        {"type": "select", "id": "fallback", "label": "Bundled fallback", "options": [{"value": "milk", "label": "Highlight milk"}, {"value": "bronze", "label": "Pocket bronze"}, {"value": "blush", "label": "Pocket blush"}, {"value": "shape", "label": "Peptide lip shape"}, {"value": "tint", "label": "Peptide lip tint"}], "default": "milk"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Heresy summer routine",
      "blocks": [
        {"type": "step", "settings": {"navigation_label": "HIGHLIGHT", "product_name": "highlight milk", "description": "<p>apply to bare skin or mix with foundation for a natural, pearly glow</p>", "fallback": "milk"}},
        {"type": "step", "settings": {"navigation_label": "BRONZE", "product_name": "pocket bronze", "description": "<p>tap onto forehead, cheeks, nose, and jawline for long-wearing warmth</p>", "fallback": "bronze"}},
        {"type": "step", "settings": {"navigation_label": "FLUSH", "product_name": "pocket blush", "description": "<p>tap onto cheeks and lips for satiny, buildable color</p>", "fallback": "blush"}},
        {"type": "step", "settings": {"navigation_label": "SHAPE", "product_name": "peptide lip shape", "description": "<p>glide along the outline of your lips for a soft-focus, contoured effect</p>", "fallback": "shape"}},
        {"type": "step", "settings": {"navigation_label": "TINT", "product_name": "peptide lip tint", "description": "<p>swipe it on for a hint of tint and high-shine finish</p>", "fallback": "tint"}}
      ]
    }
  ]
}
{% endschema %}
