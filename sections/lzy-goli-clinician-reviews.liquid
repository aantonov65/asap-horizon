{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}

<section class="lzy-goli-reviews">
  <div class="lzy-goli-reviews__heading">
    <span></span>
    <h2>{{ section.settings.heading }}</h2>
    <span></span>
  </div>
  <p>{{ section.settings.copy }}</p>
  {% if section.settings.enable_frontrow %}
    <script async type="text/javascript" src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=qual&product_id={{ section.settings.frontrow_product_id | escape }}"></script>
    <iframe class="lzy-goli-reviews__frame" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=qual&product_id={{ section.settings.frontrow_product_id | escape }}"></iframe>
  {% endif %}
</section>

{% schema %}
{
  "name": "Goli Clinician Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinician Reviews"
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Copy",
      "default": "Independent clinician evaluations from FrontrowMD."
    },
    {
      "type": "checkbox",
      "id": "enable_frontrow",
      "label": "Enable Frontrow embed",
      "default": false
    },
    {
      "type": "text",
      "id": "frontrow_product_id",
      "label": "Frontrow product ID",
      "default": "3284"
    }
  ],
  "presets": [
    {
      "name": "Goli Clinician Reviews"
    }
  ]
}
{% endschema %}
