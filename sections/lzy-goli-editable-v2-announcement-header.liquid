{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

<header class="lzy-goli-root lzy-goli-header" data-lzy-section="announcement-header">
  <div class="lzy-goli-announcement">{{ section.settings.announcement_text }}</div>
  <nav class="lzy-goli-nav" aria-label="Primary navigation">
    <a class="lzy-goli-logo-link" href="{{ section.settings.logo_url }}" aria-label="Goli home">
      {% if section.settings.logo_image != blank %}
        <img src="{{ section.settings.logo_image | image_url: width: 295 }}" width="295" height="211" alt="goli" loading="eager">
      {% else %}
        <img src="data:image/svg+xml;base64," width="295" height="211" alt="goli" loading="eager">
      {% endif %}
    </a>
    <button class="lzy-goli-mobile-menu" type="button" aria-expanded="false">{{ section.settings.menu_label }}</button>
    <div class="lzy-goli-nav-links">
      <div class="lzy-goli-menu-group">
        <button type="button" class="lzy-goli-nav-button">{{ section.settings.products_label }}</button>
        <div class="lzy-goli-dropdown">
          {% for block in section.blocks %}
            {% if block.type == 'product_link' %}
              <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% for block in section.blocks %}
        {% if block.type == 'nav_link' %}
          <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {% endif %}
      {% endfor %}
    </div>
    <a class="lzy-goli-nav-cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}<span>{{ section.settings.cta_subtext }}</span></a>
    <button class="lzy-goli-cart-trigger" type="button" aria-label="{{ section.settings.cart_label }}">
      <img src="data:image/svg+xml;base64," width="35" height="35" alt="" loading="lazy">
      <span>0</span>
    </button>
  </nav>
</header>

{% schema %}
{
  "name": "Goli Editable V2 Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement",
