{{ 'heresy-shared.css' | asset_url | stylesheet_tag }}
{{ 'heresy-meet-shades.css' | asset_url | stylesheet_tag }}
<script src="{{ 'heresy-meet-shades.js' | asset_url }}" defer></script>

<section class="heresy-meet-shades mod_shades_carousel_1Jliaa_MeetShades Section" id="heresy-meet-shades-{{ section.id }}" data-heresy-section="{{ section.id }}" data-heresy-shades>
  <div class="mod_shades_carousel_1Jliaa_MeetShades__header">
    <h2 class="mod_shades_carousel_1Jliaa_MeetShades__title">{{ section.settings.heading }}</h2>
    <div class="mod_shades_carousel_1Jliaa_MeetShades__thumbs-wrapper">
      <button type="button" class="mod_shades_carousel_1Jliaa_MeetShades__thumbs-prev" data-heresy-shades-prev aria-label="Previous shade">
        <svg fill="none" height="11" viewBox="0 0 7 11" width="7" aria-hidden="true"><path d="M1 0.5L6 5.68519L1 10.5" stroke="#67645E" stroke-linecap="round"></path></svg>
      </button>
      <div class="mod_shades_carousel_1Jliaa_MeetShades__swatches">
        <div class="heresy-meet-shades__swatch-track">
          {% for block in section.blocks %}
            <button type="button" class="mod_shades_carousel_1Jliaa_MeetShades__swatch{% if forloop.first %} heresy-is-selected{% endif %}" data-heresy-shade-go="{{ forloop.index0 }}" aria-label="Select {{ block.settings.title | escape }} shade" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" style="background-color: {{ block.settings.color }};"></button>
          {% endfor %}
        </div>
      </div>
      <button type="button" class="mod_shades_carousel_1Jliaa_MeetShades__thumbs-next" data-heresy-shades-next aria-label="Next shade">
        <svg fill="none" height="11" viewBox="0 0 7 11" width="7" aria-hidden="true"><path d="M1 0.5L6 5.68519L1 10.5" stroke="#67645E" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>

  <div class="mod_shades_carousel_1Jliaa_MeetShades__content" data-heresy-shade-track>
    <ul class="heresy-meet-shades__cards">
      {% for block in section.blocks %}
        {% assign fallback_asset = block.settings.fallback | prepend: 'heresy-shade-' | append: '.jpg' %}
        <li class="mod_shades_carousel_1Jliaa_MeetShades__card" data-heresy-shade-card="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {% if block.settings.product != blank %}<a class="heresy-meet-shades__card-link" href="{{ block.settings.product.url }}">{% endif %}
          <div class="mod_shades_carousel_1Jliaa_MeetShades__card-image">
            <span class="Image Image--desktop o-placeholder bg-full-height skip-animation">
              {% render 'heresy-responsive-image', image: block.settings.image, fallback_asset: fallback_asset, alt: block.settings.image_alt, class: 'skip-animation heresy-meet-shades__image', width: 640, height: 640 %}
            </span>
          </div>
          <div class="mod_shades_carousel_1Jliaa_MeetShades__card-text">
            <div class="mod_shades_carousel_1Jliaa_MeetShades__card-text-top">
              <span class="Product-swatches-popup-color" style="background-color: {{ block.settings.color }};"></span>
              <h3 class="mod_shades_carousel_1Jliaa_MeetShades__card-title">{{ block.settings.title }}</h3>
            </div>
            <p class="mod_shades_carousel_1Jliaa_MeetShades__card-description">{{ block.settings.description }}</p>
          </div>
          {% if block.settings.product != blank %}</a>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
  <div class="mod_shades_carousel_1Jliaa_MeetShades__controls">
    <div class="mod_shades_carousel_1Jliaa_MeetShades__controls__scrollbar__wrapper">
      <span class="mod_shades_carousel_1Jliaa_MeetShades__controls__scrollbar" data-heresy-shades-progress></span>
    </div>
    <div class="mod_shades_carousel_1Jliaa_MeetShades__controls__buttons">
      <button type="button" class="mod_shades_carousel_1Jliaa_MeetShades__controls__button" data-heresy-shades-prev aria-label="Previous shade">
        <svg fill="none" height="11" viewBox="0 0 7 11" width="7" aria-hidden="true"><path d="M6 10.5L1 5.31481L6 0.5" stroke="#67645E" stroke-linecap="round"></path></svg>
      </button>
      <button type="button" class="mod_shades_carousel_1Jliaa_MeetShades__controls__button" data-heresy-shades-next aria-label="Next shade">
        <svg fill="none" height="11" viewBox="0 0 7 11" width="7" aria-hidden="true"><path d="M1 0.5L6 5.68519L1 10.5" stroke="#67645E" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heresy meet shades",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "meet the shades"}
  ],
  "blocks": [
    {
      "type": "shade",
      "name": "Shade",
      "settings": [
        {"type": "product", "id": "product", "label": "Product"},
        {"type": "text", "id": "title", "label": "Name", "default": "push"},
        {"type": "text", "id": "description", "label": "Description", "default": "soft neutral beige"},
        {"type": "color", "id": "color", "label": "Swatch", "default": "#b68574"},
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "image_alt", "label": "Image alt text", "default": "Model wearing peptide lip shape"},
        {"type": "select", "id": "fallback", "label": "Bundled fallback", "options": [{"value": "lift", "label": "Lift"}, {"value": "push", "label": "Push"}, {"value": "press", "label": "Press"}, {"value": "bend", "label": "Bend"}, {"value": "squeeze", "label": "Squeeze"}, {"value": "lunge", "label": "Lunge"}, {"value": "twist", "label": "Twist"}, {"value": "balance", "label": "Balance"}, {"value": "lean", "label": "Lean"}, {"value": "jump", "label": "Jump"}, {"value": "stretch", "label": "Stretch"}, {"value": "flex", "label": "Flex"}, {"value": "spin", "label": "Spin"}, {"value": "move", "label": "Move"}], "default": "push"}
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Heresy meet shades",
      "blocks": [
        {"type": "shade", "settings": {"title": "lift", "description": "soft neutral pink", "color": "#c18d93", "fallback": "lift"}},
        {"type": "shade", "settings": {"title": "push", "description": "soft neutral beige", "color": "#b68574", "fallback": "push"}},
        {"type": "shade", "settings": {"title": "press", "description": "warm pinky mauve", "color": "#be7984", "fallback": "press"}},
        {"type": "shade", "settings": {"title": "bend", "description": "soft peachy beige", "color": "#b6806a", "fallback": "bend"}},
        {"type": "shade", "settings": {"title": "squeeze", "description": "cool taupe", "color": "#bb7055", "fallback": "squeeze"}},
        {"type": "shade", "settings": {"title": "lunge", "description": "rosy beige", "color": "#ab7265", "fallback": "lunge"}},
        {"type": "shade", "settings": {"title": "twist", "description": "warm taupe", "color": "#a57462", "fallback": "twist"}},
        {"type": "shade", "settings": {"title": "balance", "description": "caramel brown", "color": "#906650", "fallback": "balance"}},
        {"type": "shade", "settings": {"title": "lean", "description": "warm medium brown", "color": "#96665d", "fallback": "lean"}},
        {"type": "shade", "settings": {"title": "jump", "description": "chocolate brown", "color": "#874936", "fallback": "jump"}},
        {"type": "shade", "settings": {"title": "stretch", "description": "neutral mocha brown", "color": "#81594a", "fallback": "stretch"}},
        {"type": "shade", "settings": {"title": "flex", "description": "rich neutral brown", "color": "#5c4237", "fallback": "flex"}},
        {"type": "shade", "settings": {"title": "spin", "description": "rich plum brown", "color": "#4c3941", "fallback": "spin"}},
        {"type": "shade", "settings": {"title": "move", "description": "deep cool brown", "color": "#463832", "fallback": "move"}}
      ]
    }
  ]
}
{% endschema %}
