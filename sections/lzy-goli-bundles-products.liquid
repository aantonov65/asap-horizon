{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign default_pack_index = 0

  for block in section.blocks
    if block.type == 'pack' and block.settings.default_pack
      assign default_pack_index = forloop.index0
      break
    endif
  endfor

  assign default_pack_block = section.blocks[default_pack_index]

  if default_pack_block == blank
    assign default_pack_block = section.blocks.first
  endif

  assign default_pack_product = blank
  assign default_pack_variant = blank
  assign default_pack_allocation = blank
  assign default_pack_size = 1

  if default_pack_block != blank and default_pack_block.settings.product != blank
    assign default_pack_size = default_pack_block.settings.pack_size | at_least: 1
    assign default_pack_product = default_pack_block.settings.product
    assign default_pack_variant = default_pack_product.selected_or_first_available_variant
    assign default_pack_allocation = default_pack_product.selected_or_first_available_selling_plan_allocation

    if default_pack_block.settings.subscribe_selling_plan_id != blank and default_pack_variant != blank
      assign default_pack_allocation = blank
      for allocation in default_pack_variant.selling_plan_allocations
        if allocation.selling_plan.id == default_pack_block.settings.subscribe_selling_plan_id
          assign default_pack_allocation = allocation
          break
        endif
      endfor
    endif
  endif
-%}

<lzy-goli-bundles-products
  class="lzy-goli-bundles-products"
  id="lzy-bundle-builder-{{ section.id }}"
  data-default-mode="{{ section.settings.default_purchase_mode }}"
  data-default-pack="{{ default_pack_index }}"
  data-cart-add-url="{{ routes.root_url }}cart/add.js"
  data-checkout-url="{{ routes.root_url }}checkout"
  style="
    --lzy-goli-bundles-products-bg: {{ section.settings.section_background }};
    --lzy-goli-bundles-products-heading: {{ section.settings.heading_color }};
    --lzy-goli-bundles-products-card-bg: {{ section.settings.card_background }};
    --lzy-goli-bundles-products-card-border: {{ section.settings.card_border }};
    --lzy-goli-bundles-products-active: {{ section.settings.active_color }};
    --lzy-goli-bundles-products-active-text: {{ section.settings.active_text_color }};
    --lzy-goli-bundles-products-button-bg: {{ section.settings.button_background }};
    --lzy-goli-bundles-products-button-text: {{ section.settings.button_text_color }};
  "
>
  <section class="lzy-goli-bundles-products__section">
    <div class="lzy-goli-bundles-products__inner">
      <div class="lzy-goli-bundles-products__header">
        <h2>{{ section.settings.heading }}</h2>
        <p>
          {{ section.settings.includes_label }}
          <strong>{{ section.settings.includes_text }}</strong>
        </p>
      </div>

      <div class="lzy-goli-bundles-products__layout">
        <div class="lzy-goli-bundles-products__visuals">
          {%- for block in section.blocks -%}
            {%- liquid
              assign pack_product = block.settings.product
              assign pack_variant = blank
              assign pack_image = block.settings.bundle_image
              assign pack_alt = block.settings.bundle_alt

              if pack_product != blank
                assign pack_variant = pack_product.selected_or_first_available_variant
                if pack_image == blank
                  assign pack_image = pack_product.featured_image
                endif
                if pack_alt == blank
                  assign pack_alt = pack_product.title
                endif
              endif
            -%}
            <div
              class="lzy-goli-bundles-products__visual{% if forloop.index0 == default_pack_index %} lzy-is-active{% endif %}"
              data-pack-visual="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.badge_image != blank -%}
                {{ block.settings.badge_image | image_url: width: 224 | image_tag: class: 'lzy-goli-bundles-products__badge', loading: 'lazy' }}
              {%- endif -%}

              {%- if pack_image != blank -%}
                {{ pack_image | image_url: width: 900 | image_tag: class: 'lzy-goli-bundles-products__bundle-image', loading: 'lazy', alt: pack_alt }}
              {%- else -%}
                <div class="lzy-goli-bundles-products__bundle-placeholder">{{ block.settings.pack_label }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="lzy-goli-bundles-products__content">
          <div class="lzy-goli-bundles-products__purchase-toggle" role="tablist" aria-label="{{ section.settings.purchase_toggle_label }}">
            <button
              class="lzy-goli-bundles-products__purchase-button"
              type="button"
              role="tab"
              aria-selected="{% if section.settings.default_purchase_mode == 'subscribe' %}true{% else %}false{% endif %}"
              data-mode-button="subscribe"
            >
              {%- if section.settings.subscribe_badge != blank -%}
                <span class="lzy-goli-bundles-products__purchase-badge">{{ section.settings.subscribe_badge }}</span>
              {%- endif -%}
              <span class="lzy-goli-bundles-products__purchase-label">{{ section.settings.subscribe_label }}</span>
              <div class="lzy-goli-bundles-products__purchase-pricing">
                <strong data-price-unit>
                  {%- if default_pack_variant != blank and default_pack_block != blank -%}
                    {%- liquid
                      assign default_subscribe_total_raw = default_pack_variant.price
                      assign default_subscribe_compare_raw = default_pack_variant.compare_at_price | default: default_pack_variant.price

                      if default_pack_allocation != blank
                        assign default_subscribe_total_raw = default_pack_allocation.price
                        assign default_subscribe_compare_raw = default_pack_allocation.compare_at_price | default: default_subscribe_compare_raw
                      endif
                    -%}
                    {{ default_subscribe_total_raw | divided_by: default_pack_size | money }}
                  {%- endif -%}
                </strong>
                <span>{{ section.settings.each_label }}</span>
                <em>{{ section.settings.total_label }} <b data-price-total>{%- if default_pack_variant != blank -%}{{ default_subscribe_total_raw | money }}{%- endif -%}</b></em>
                <s data-price-compare>{%- if default_pack_variant != blank -%}{{ default_subscribe_compare_raw | money }}{%- endif -%}</s>
              </div>
            </button>

            <button
              class="lzy-goli-bundles-products__purchase-button"
              type="button"
              role="tab"
              aria-selected="{% if section.settings.default_purchase_mode == 'onetime' %}true{% else %}false{% endif %}"
              data-mode-button="onetime"
            >
              <span class="lzy-goli-bundles-products__purchase-label">{{ section.settings.onetime_label }}</span>
              <div class="lzy-goli-bundles-products__purchase-pricing">
                <strong data-onetime-unit>
                  {%- if default_pack_variant != blank and default_pack_block != blank -%}
                    {{ default_pack_variant.price | divided_by: default_pack_size | money }}
                  {%- endif -%}
                </strong>
                <span>{{ section.settings.each_label }}</span>
                <em>{{ section.settings.total_label }} <b data-onetime-total>{%- if default_pack_variant != blank -%}{{ default_pack_variant.price | money }}{%- endif -%}</b></em>
                <s data-onetime-compare>{%- if default_pack_variant != blank -%}{{ default_pack_variant.compare_at_price | default: default_pack_variant.price | money }}{%- endif -%}</s>
              </div>
            </button>
          </div>

          <div class="lzy-goli-bundles-products__pack-grid" role="list" aria-label="{{ section.settings.pack_selector_label }}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign pack_product = block.settings.product
                assign pack_variant = blank
                assign pack_allocation = blank
                assign pack_size = block.settings.pack_size | at_least: 1
                assign pack_requires_subscription = false

                if pack_product != blank
                  assign pack_variant = pack_product.selected_or_first_available_variant
                  assign pack_allocation = pack_product.selected_or_first_available_selling_plan_allocation

                  if block.settings.subscribe_selling_plan_id != blank and pack_variant != blank
                    assign pack_allocation = blank
                    for allocation in pack_variant.selling_plan_allocations
                      if allocation.selling_plan.id == block.settings.subscribe_selling_plan_id
                        assign pack_allocation = allocation
                        break
                      endif
                    endfor
                  endif

                  if pack_allocation != blank
                    assign pack_requires_subscription = true
                  endif
                endif

                assign pack_onetime_total_raw = 0
                assign pack_onetime_compare_raw = 0
                assign pack_subscribe_total_raw = 0
                assign pack_subscribe_compare_raw = 0
                assign pack_subscribe_selling_plan_id = ''

                if pack_variant != blank
                  assign pack_onetime_total_raw = pack_variant.price
                  assign pack_onetime_compare_raw = pack_variant.compare_at_price | default: pack_variant.price
                  assign pack_subscribe_total_raw = pack_variant.price
                  assign pack_subscribe_compare_raw = pack_variant.compare_at_price | default: pack_variant.price

                  if pack_allocation != blank
                    assign pack_subscribe_total_raw = pack_allocation.price
                    assign pack_subscribe_compare_raw = pack_allocation.compare_at_price | default: pack_subscribe_compare_raw
                    assign pack_subscribe_selling_plan_id = pack_allocation.selling_plan.id
                  endif
                endif
              -%}
              <button
                class="lzy-goli-bundles-products__pack-button{% if forloop.index0 == default_pack_index %} lzy-is-active{% endif %}"
                type="button"
                role="listitem"
                data-pack-button="{{ forloop.index0 }}"
                data-pack-variant-id="{% if pack_variant != blank %}{{ pack_variant.id }}{% endif %}"
                data-pack-subscribe-selling-plan-id="{{ pack_subscribe_selling_plan_id }}"
                data-pack-subscribe-enabled="{% if pack_requires_subscription %}true{% else %}false{% endif %}"
                data-pack-subscribe-unit="{% if pack_variant != blank %}{{ pack_subscribe_total_raw | divided_by: pack_size | money | escape }}{% endif %}"
                data-pack-subscribe-total="{% if pack_variant != blank %}{{ pack_subscribe_total_raw | money | escape }}{% endif %}"
                data-pack-subscribe-compare="{% if pack_variant != blank %}{{ pack_subscribe_compare_raw | money | escape }}{% endif %}"
                data-pack-onetime-unit="{% if pack_variant != blank %}{{ pack_onetime_total_raw | divided_by: pack_size | money | escape }}{% endif %}"
                data-pack-onetime-total="{% if pack_variant != blank %}{{ pack_onetime_total_raw | money | escape }}{% endif %}"
                data-pack-onetime-compare="{% if pack_variant != blank %}{{ pack_onetime_compare_raw | money | escape }}{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.pack_label }}
              </button>
            {%- endfor -%}
          </div>

          <button
            class="lzy-goli-bundles-products__checkout"
            type="button"
            data-checkout-button
          >
            {{ section.settings.checkout_label }}
          </button>
        </div>
      </div>
    </div>
  </section>
</lzy-goli-bundles-products>

{% schema %}
{
  "name": "LZY Goli Bundles Products",
  "tag": "section",
  "class": "section-lzy-goli-bundles-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Zero Sugar Essentials"
    },
    {
      "type": "text",
      "id": "includes_label",
      "label": "Includes label",
      "default": "Includes:"
    },
    {
      "type": "text",
      "id": "includes_text",
      "label": "Includes text",
      "default": "Zero Sugar ACV+, Pre+Post+Probiotics, and Ashwa+ Gummies"
    },
    {
      "type": "text",
      "id": "purchase_toggle_label",
      "label": "Purchase toggle aria label",
      "default": "Purchase type"
    },
    {
      "type": "text",
      "id": "pack_selector_label",
      "label": "Pack selector aria label",
      "default": "Pack size options"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "subscribe_badge",
      "label": "Subscribe badge",
      "default": "10% OFF & Cancel Anytime"
    },
    {
      "type": "text",
      "id": "onetime_label",
      "label": "One-time label",
      "default": "One-time Purchase"
    },
    {
      "type": "text",
      "id": "each_label",
      "label": "Each label",
      "default": "each"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total:"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout label",
      "default": "Checkout Now"
    },
    {
      "type": "select",
      "id": "default_purchase_mode",
      "label": "Default purchase mode",
      "options": [
        {
          "value": "subscribe",
          "label": "Subscribe"
        },
        {
          "value": "onetime",
          "label": "One-time"
        }
      ],
      "default": "subscribe"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f8e0e0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#d63a3a"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#d7d0d0"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active card color",
      "default": "#d63a3a"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Active text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Checkout button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Checkout button text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product"
        },
        {
          "type": "text",
          "id": "pack_label",
          "label": "Pack label",
          "default": "3-PACK"
        },
        {
          "type": "range",
          "id": "pack_size",
          "label": "Units in pack",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 3
        },
        {
          "type": "checkbox",
          "id": "default_pack",
          "label": "Default selected pack",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "bundle_image",
          "label": "Override bundle image"
        },
        {
          "type": "text",
          "id": "bundle_alt",
          "label": "Bundle image alt"
        },
        {
          "type": "image_picker",
          "id": "badge_image",
          "label": "Badge image"
        },
        {
          "type": "text",
          "id": "subscribe_selling_plan_id",
          "label": "Subscription selling plan ID"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "LZY Goli Bundles Products",
      "blocks": [
        {
          "type": "pack",
          "settings": {
            "pack_label": "3-PACK",
            "pack_size": 3,
            "default_pack": true
          }
        },
        {
          "type": "pack",
          "settings": {
            "pack_label": "6-PACK",
            "pack_size": 6,
            "default_pack": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
