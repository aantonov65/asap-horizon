{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign default_pack_index = 0

  for block in section.blocks
    if block.type == 'pack' and block.settings.default_pack
      assign default_pack_index = forloop.index0
      break
    endif
  endfor

  assign default_pack_block = section.blocks[default_pack_index]

  if default_pack_block == blank
    assign default_pack_block = section.blocks.first
  endif

  assign default_pack_variant = blank
  assign default_pack_allocation = blank
  assign default_pack_size = 1
  assign default_pack_quantity = ''
  assign default_bundle_image = ''
  assign default_subscribe_badge = ''
  assign default_subscribe_total_raw = 0
  assign default_subscribe_compare_raw = 0
  assign default_onetime_total_raw = 0
  assign default_onetime_compare_raw = 0

  if default_pack_block != blank
    assign default_pack_size = default_pack_block.settings.pack_size | at_least: 1
    assign default_pack_quantity = default_pack_block.settings.pack_size | append: ''
    assign default_bundle_image = default_pack_block.settings.bundle_image_url
    assign default_subscribe_badge = default_pack_block.settings.subscribe_badge_image_url

    if default_pack_block.settings.bundle_image != blank
      assign default_bundle_image = default_pack_block.settings.bundle_image | image_url: width: 1200
    endif

    if default_pack_block.settings.subscribe_badge_image != blank
      assign default_subscribe_badge = default_pack_block.settings.subscribe_badge_image | image_url: width: 200
    endif

    if default_pack_block.settings.product != blank
      assign default_pack_variant = default_pack_block.settings.product.selected_or_first_available_variant
      assign default_pack_allocation = default_pack_block.settings.product.selected_or_first_available_selling_plan_allocation

      if default_pack_variant != blank and default_pack_block.settings.subscribe_selling_plan_id != blank
        assign default_pack_allocation = blank
        for allocation in default_pack_variant.selling_plan_allocations
          if allocation.selling_plan.id == default_pack_block.settings.subscribe_selling_plan_id
            assign default_pack_allocation = allocation
            break
          endif
        endfor
      endif

      if default_pack_variant != blank
        assign default_onetime_total_raw = default_pack_variant.price
        assign default_onetime_compare_raw = default_pack_variant.compare_at_price | default: default_pack_variant.price
        assign default_subscribe_total_raw = default_pack_variant.price
        assign default_subscribe_compare_raw = default_pack_variant.compare_at_price | default: default_pack_variant.price

        if default_pack_allocation != blank
          assign default_subscribe_total_raw = default_pack_allocation.price
          assign default_subscribe_compare_raw = default_pack_allocation.compare_at_price | default: default_subscribe_compare_raw
        endif
      endif

      if default_bundle_image == blank and default_pack_block.settings.product.featured_image != blank
        assign default_bundle_image = default_pack_block.settings.product.featured_image | image_url: width: 1200
      endif
    endif
  endif

  capture bundle_data_json
    echo '{"packs":['
    for block in section.blocks
      if block.type == 'pack'
        assign pack_product = block.settings.product
        assign pack_variant = blank
        assign pack_allocation = blank
        assign pack_image = block.settings.bundle_image_url
        assign pack_subscribe_badge = block.settings.subscribe_badge_image_url
        assign pack_onetime_badge = block.settings.onetime_badge_image_url
        assign pack_size = block.settings.pack_size | at_least: 1
        assign pack_subscribe_total_raw = 0
        assign pack_subscribe_compare_raw = 0
        assign pack_onetime_total_raw = 0
        assign pack_onetime_compare_raw = 0
        assign pack_variant_id = 'null'
        assign pack_selling_plan_id = 'null'
        assign pack_subscribe_supported = false
        assign pack_alt = block.settings.bundle_alt

        if block.settings.bundle_image != blank
          assign pack_image = block.settings.bundle_image | image_url: width: 1200
        endif

        if block.settings.subscribe_badge_image != blank
          assign pack_subscribe_badge = block.settings.subscribe_badge_image | image_url: width: 200
        endif

        if block.settings.onetime_badge_image != blank
          assign pack_onetime_badge = block.settings.onetime_badge_image | image_url: width: 200
        endif

        if pack_product != blank
          assign pack_variant = pack_product.selected_or_first_available_variant
          assign pack_allocation = pack_product.selected_or_first_available_selling_plan_allocation

          if pack_variant != blank and block.settings.subscribe_selling_plan_id != blank
            assign pack_allocation = blank
            for allocation in pack_variant.selling_plan_allocations
              if allocation.selling_plan.id == block.settings.subscribe_selling_plan_id
                assign pack_allocation = allocation
                break
              endif
            endfor
          endif

          if pack_variant != blank
            assign pack_variant_id = pack_variant.id | json
            assign pack_onetime_total_raw = pack_variant.price
            assign pack_onetime_compare_raw = pack_variant.compare_at_price | default: pack_variant.price
            assign pack_subscribe_total_raw = pack_variant.price
            assign pack_subscribe_compare_raw = pack_variant.compare_at_price | default: pack_variant.price

            if pack_allocation != blank
              assign pack_subscribe_total_raw = pack_allocation.price
              assign pack_subscribe_compare_raw = pack_allocation.compare_at_price | default: pack_subscribe_compare_raw
              assign pack_selling_plan_id = pack_allocation.selling_plan.id | json
              assign pack_subscribe_supported = true
            endif
          endif

          if pack_image == blank and pack_product.featured_image != blank
            assign pack_image = pack_product.featured_image | image_url: width: 1200
          endif
        endif

        if forloop.first == false
          echo ','
        endif

        echo '{'
        echo '"quantity":'
        echo pack_size | append: '' | json
        echo ',"label":'
        echo pack_size | append: '-Pack' | json
        echo ',"preselect":'
        if block.settings.default_pack
          echo 'true'
        else
          echo 'false'
        endif
        echo ',"image":'
        echo pack_image | json
        echo ',"alt":'
        echo pack_alt | json
        echo ',"discount":{"subscribe":'
        echo pack_subscribe_badge | json
        echo ',"onetime":'
        echo pack_onetime_badge | json
        echo '}'
        echo ',"pricing":{"subscribe":{"unit":'
        echo pack_subscribe_total_raw | divided_by: pack_size | money | json
        echo ',"total":'
        echo pack_subscribe_total_raw | money | json
        echo ',"compare":'
        echo pack_subscribe_compare_raw | money | json
        echo '},"onetime":{"unit":'
        echo pack_onetime_total_raw | divided_by: pack_size | money | json
        echo ',"total":'
        echo pack_onetime_total_raw | money | json
        echo ',"compare":'
        echo pack_onetime_compare_raw | money | json
        echo '}}'
        echo ',"variantId":'
        echo pack_variant_id
        echo ',"sellingPlanId":'
        echo pack_selling_plan_id
        echo ',"subscribeSupported":'
        if pack_subscribe_supported
          echo 'true'
        else
          echo 'false'
        endif
        echo '}'
      endif
    endfor
    echo ']}'
  endcapture
-%}

<section
  class="lzy-bundle-builder"
  id="lzy-bundle-builder-{{ section.id }}"
  data-lzy-bundle-builder
  data-default-mode="{{ section.settings.default_purchase_mode }}"
  data-default-pack="{{ default_pack_quantity }}"
  data-cart-add-url="{{ routes.root_url }}cart/add.js"
  data-checkout-url="{{ routes.root_url }}checkout"
  data-bundle-data='{{ bundle_data_json | strip | escape }}'
  style="
    --lzy-card-pink: {{ section.settings.section_background }};
    --lzy-red: {{ section.settings.active_color }};
    --lzy-button-background: {{ section.settings.button_background }};
    --lzy-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="lzy-bundle-builder__inner">
    <div class="lzy-bundle-builder__header">
      <h1>{{ section.settings.heading }}</h1>
      <p>
        {{ section.settings.includes_label }}
        <strong>{{ section.settings.includes_text }}</strong>
      </p>
    </div>

    <div class="lzy-bundle-card" id="lzyBundleCard-{{ section.id }}">
      <div class="lzy-bundle-card__visual">
        <div class="lzy-bundle-card__badge">
          <img id="lzyBundleBadge-{{ section.id }}" src="{{ default_subscribe_badge }}" alt="Bundle discount sticker" width="200" height="200">
        </div>
        <img id="lzyBundleImage-{{ section.id }}" src="{{ default_bundle_image }}" alt="Selected Goli bundle" width="1200" height="1200">
      </div>

      <div class="lzy-bundle-card__content">
        <div
          class="lzy-purchase-toggle"
          role="tablist"
          aria-label="{{ section.settings.purchase_toggle_label }}"
        >
          <button
            class="lzy-purchase-toggle__button"
            data-purchase="subscribe"
            type="button"
            role="tab"
            aria-selected="false"
          >
            <span class="lzy-purchase-toggle__badge">{{ section.settings.subscribe_badge }}</span>
            <span>{{ section.settings.subscribe_label }}</span>
            <div class="lzy-purchase-toggle__pricing">
              <strong id="lzyUnitPrice-{{ section.id }}">{{ default_subscribe_total_raw | divided_by: default_pack_size | money }}</strong>
              <span>{{ section.settings.each_label }}</span>
              <em>{{ section.settings.total_label }} <b id="lzyTotalPrice-{{ section.id }}">{{ default_subscribe_total_raw | money }}</b></em>
              <s id="lzyComparePrice-{{ section.id }}">{{ default_subscribe_compare_raw | money }}</s>
            </div>
          </button>
          <button
            class="lzy-purchase-toggle__button"
            data-purchase="onetime"
            type="button"
            role="tab"
            aria-selected="false"
          >
            <span>{{ section.settings.onetime_label }}</span>
            <div class="lzy-purchase-toggle__pricing">
              <strong id="lzyUnitPriceSecondary-{{ section.id }}">{{ default_onetime_total_raw | divided_by: default_pack_size | money }}</strong>
              <span>{{ section.settings.each_label }}</span>
              <em>{{ section.settings.total_label }} <b id="lzyTotalPriceSecondary-{{ section.id }}">{{ default_onetime_total_raw | money }}</b></em>
              <s id="lzyComparePriceSecondary-{{ section.id }}">{{ default_onetime_compare_raw | money }}</s>
            </div>
          </button>
        </div>

        <div
          class="lzy-pack-grid"
          id="lzyPackGrid-{{ section.id }}"
          aria-label="{{ section.settings.pack_selector_label }}"
        >
          {% for block in section.blocks %}
            {% if block.type == 'pack' %}
              {% liquid
                assign pack_product = block.settings.product
                assign pack_variant = blank
                assign pack_size = block.settings.pack_size | at_least: 1

                if pack_product != blank
                  assign pack_variant = pack_product.selected_or_first_available_variant
                endif
              %}
              <button
                class="lzy-pack-option"
                type="button"
                data-pack-option
                data-pack-quantity="{{ pack_size }}"
                {% if pack_variant == blank %}disabled{% endif %}
                {{ block.shopify_attributes }}
              >
                {{ pack_size }}-PACK
              </button>
            {% endif %}
          {% endfor %}
        </div>

        <button
          class="lzy-button lzy-button--dark lzy-button--wide"
          id="lzyCheckoutButton-{{ section.id }}"
          type="button"
        >
          {{ section.settings.checkout_label }}
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LZY Goli bundles products",
  "tag": "section",
  "class": "section-lzy-goli-bundles-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Zero Sugar Essentials"
    },
    {
      "type": "text",
      "id": "includes_label",
      "label": "Includes label",
      "default": "Includes:"
    },
    {
      "type": "text",
      "id": "includes_text",
      "label": "Includes text",
      "default": "Zero Sugar ACV+, Pre+Post+Probiotics, and Ashwa+ Gummies"
    },
    {
      "type": "text",
      "id": "purchase_toggle_label",
      "label": "Purchase toggle aria label",
      "default": "Purchase type"
    },
    {
      "type": "text",
      "id": "pack_selector_label",
      "label": "Pack selector aria label",
      "default": "Pack size options"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "subscribe_badge",
      "label": "Subscribe badge",
      "default": "10% OFF & Cancel Anytime"
    },
    {
      "type": "text",
      "id": "onetime_label",
      "label": "One-time label",
      "default": "One-time Purchase"
    },
    {
      "type": "text",
      "id": "each_label",
      "label": "Each label",
      "default": "each"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total:"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout label",
      "default": "Checkout Now"
    },
    {
      "type": "select",
      "id": "default_purchase_mode",
      "label": "Default purchase mode",
      "options": [
        {
          "value": "subscribe",
          "label": "Subscribe"
        },
        {
          "value": "onetime",
          "label": "One-time"
        }
      ],
      "default": "subscribe"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f8e0e0"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active color",
      "default": "#d7282f"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product"
        },
        {
          "type": "range",
          "id": "pack_size",
          "label": "Units in pack",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 3
        },
        {
          "type": "checkbox",
          "id": "default_pack",
          "label": "Default selected pack",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "bundle_image",
          "label": "Bundle image override"
        },
        {
          "type": "url",
          "id": "bundle_image_url",
          "label": "Bundle image fallback URL"
        },
        {
          "type": "text",
          "id": "bundle_alt",
          "label": "Bundle image alt",
          "default": "Selected Goli bundle"
        },
        {
          "type": "image_picker",
          "id": "subscribe_badge_image",
          "label": "Subscribe badge image"
        },
        {
          "type": "url",
          "id": "subscribe_badge_image_url",
          "label": "Subscribe badge fallback URL"
        },
        {
          "type": "image_picker",
          "id": "onetime_badge_image",
          "label": "One-time badge image"
        },
        {
          "type": "url",
          "id": "onetime_badge_image_url",
          "label": "One-time badge fallback URL"
        },
        {
          "type": "text",
          "id": "subscribe_selling_plan_id",
          "label": "Subscription selling plan ID"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Goli bundles products",
      "blocks": [
        {
          "type": "pack",
          "settings": {
            "pack_size": 3,
            "default_pack": true,
            "bundle_image_url": "https://goli.com/cdn/shop/files/ZSEssentials-3pack.jpg?v=1762269135&width=1200",
            "subscribe_badge_image_url": "https://goli.com/cdn/shop/files/59OFF-Red.png?v=1764100098&width=200",
            "onetime_badge_image_url": "https://goli.com/cdn/shop/files/55OFF-white.png?v=1764100098&width=200"
          }
        },
        {
          "type": "pack",
          "settings": {
            "pack_size": 6,
            "default_pack": false,
            "bundle_image_url": "https://goli.com/cdn/shop/files/ZSEssentials-6pack.jpg?v=1762269136&width=1200",
            "subscribe_badge_image_url": "https://goli.com/cdn/shop/files/61OFF-Red.png?v=1762537161&width=200",
            "onetime_badge_image_url": "https://goli.com/cdn/shop/files/58OFF-white.png?v=1764100098&width=200"
          }
        }
      ]
    }
  ]
}
{% endschema %}
