<section class="lzy-goli-root lzy-goli-social-strip" data-lzy-section="social-strip" aria-label="{{ section.settings.aria_label }}">{% for block in section.blocks %}<img src="{{ block.settings.asset_file | asset_url }}" width="900" height="900" alt="{{ block.settings.alt }}" loading="lazy" {{ block.shopify_attributes }}>{% endfor %}</section>

{% schema %}
{
  "name": "Goli Social Strip",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria label",
      "default": "Customer social proof images"
    }
  ],
  "blocks": [
    {
      "type": "social_image",
      "name": "Social image",
      "settings": [
        {
          "type": "text",
          "id": "asset_file",
          "label": "Asset file",
          "default": "social-1.jpg"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Social proof image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Goli Social Strip",
      "blocks": [
        {
          "type": "social_image",
          "settings": {
            "asset_file": "social-1.jpg",
            "alt": "Social proof image"
          }
        },
        {
          "type": "social_image",
          "settings": {
            "asset_file": "social-2.jpg",
            "alt": "Social proof image"
          }
        },
        {
          "type": "social_image",
          "settings": {
            "asset_file": "social-3.jpg",
            "alt": "Social proof image"
          }
        },
        {
          "type": "social_image",
          "settings": {
            "asset_file": "social-4.jpg",
            "alt": "Social proof image"
          }
        },
        {
          "type": "social_image",
          "settings": {
            "asset_file": "social-5.jpg",
            "alt": "Social proof image"
          }
        },
        {
          "type": "social_image",
          "settings": {
            "asset_file": "social-6.jpg",
            "alt": "Social proof image"
          }
        }
      ]
    }
  ]
}
{% endschema %}
