{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

<footer class="lzy-goli-root lzy-goli-footer" id="footer" data-lzy-section="footer">
  <div class="lzy-goli-footer-main">
    <div class="lzy-goli-newsletter">
      <h2>{{ section.settings.newsletter_heading }}</h2><p>{{ section.settings.newsletter_copy }}</p>
      <form data-lzy-newsletter><label for="newsletter-email-{{ section.id }}">Email</label><div><input id="newsletter-email-{{ section.id }}" name="email" type="email" placeholder="Email" required><button type="submit" aria-label="Subscribe">+</button></div><span class="lzy-goli-newsletter-message" role="status"></span></form>
      <p class="lzy-goli-follow">{{ section.settings.follow_label }}</p>
      <div class="lzy-goli-social-links" aria-label="Social links">{% for block in section.blocks %}{% if block.type == 'social_link' %}<a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{% endif %}{% endfor %}</div>
    </div>
    <nav class="lzy-goli-footer-links" aria-label="Footer navigation">{% for block in section.blocks %}{% if block.type == 'footer_link' %}<a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{% endif %}{% endfor %}</nav>
    <div class="lzy-goli-footer-marks">{% if section.settings.footer_mark_image != blank %}<img src="{{ section.settings.footer_mark_image | image_url: width: 112 }}" width="45" height="42" alt="Goli G" loading="lazy">{% else %}<img src="data:image/svg+xml;base64," width="45" height="42" alt="Goli G" loading="lazy">{% endif %}{% if section.settings.bcorp_image != blank %}<img src="{{ section.settings.bcorp_image | image_url: width: 150 }}" width="148" height="211" alt="B-Corp Logo" loading="lazy">{% else %}<img src="data:image/svg+xml;base64," width="148" height="211" alt="B-Corp Logo" loading="lazy">{% endif %}</div>
  </div>
  <div class="lzy-goli-legal-links">{% for block in section.blocks %}{% if block.type == 'legal_link' %}<a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{% endif %}{% endfor %}</div>
  <p class="lzy-goli-legal">{{ section.settings.legal_copy }}</p><p class="lzy-goli-copyright">{{ section.settings.copyright }}</p>
</footer>

{% schema %}
{
