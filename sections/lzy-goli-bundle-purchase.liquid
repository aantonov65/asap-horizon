<section class="lzy-goli-root lzy-goli-bundle" id="product-target" data-lzy-section="bundle-purchase">
  <a class="lzy-goli-review-sticker" href="{{ section.settings.review_url }}" aria-label="{{ section.settings.review_aria_label }}">
    <strong>{{ section.settings.sticker_title }}</strong>
    <span class="lzy-goli-sticker-faces">
      <img src="data:image/jpeg;base64," width="100" height="100" alt="" loading="lazy">
      <span>DA</span>
      <span>MD</span>
    </span>
    <b>{{ section.settings.sticker_link_text }}</b>
  </a>
  <div class="lzy-goli-bundle-inner">
    <header class="lzy-goli-bundle-heading">
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </header>
    <div class="lzy-goli-bundle-media">
      <img class="lzy-goli-discount-badge" src="data:image/png;base64," width="200" height="200" alt="55% off" loading="lazy">
      <img class="lzy-goli-bundle-product" src="data:image/jpeg;base64," width="400" height="400" alt="Zero Sugar Essentials 3 pack" loading="lazy">
    </div>
    <div class="lzy-goli-bundle-panel">
      <div class="lzy-goli-plan-list" role="radiogroup" aria-label="Purchase plan">
        <span class="lzy-goli-pill">{{ section.settings.pill_text }}</span>
        {% for block in section.blocks %}
          {% if block.type == 'plan' %}
            <button class="lzy-goli-plan{% if block.settings.default_selected %} lzy-is-active{% endif %}" type="button" data-plan="{{ block.settings.plan_key }}" data-price="{{ block.settings.total_price }}" data-each="{{ block.settings.each_price }}" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.label }}</strong>
              <span><b>{{ block.settings.each_price }}</b> <small>{{ section.settings.each_label }}</small> <em>{{ section.settings.total_label }} {{ block.settings.total_price }}</em> <s>{{ block.settings.compare_price }}</s></span>
            </button>
          {% endif %}
        {% endfor %}
      </div>
      <div class="lzy-goli-pack-row" aria-label="Pack size">
        {% for block in section.blocks %}
          {% if block.type == 'pack' %}
            <button class="lzy-goli-pack{% if block.settings.default_selected %} lzy-is-active{% endif %}" type="button" data-pack="{{ block.settings.label }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <button class="lzy-goli-main-checkout" type="button">{{ section.settings.checkout_label }}</button>
  </div>
  <aside class="lzy-goli-cart-drawer" aria-hidden="true" aria-label="Cart drawer">
    <button class="lzy-goli-cart-close" type="button" aria-label="Close cart">x</button>
    <h2>{{ section.settings.cart_heading }}</h2>
    <p class="lzy-goli-cart-empty">{{ section.settings.cart_empty }}</p>
    <div class="lzy-goli-cart-item" hidden>
      <strong>{{ section.settings.heading }}</strong>
      <span data-lzy-cart-plan>Subscribe &amp; Save</span>
      <span data-lzy-cart-pack>3-pack</span>
      <span data-lzy-cart-price>$30.38</span>
    </div>
    <button class="lzy-goli-checkout-button" type="button">{{ section.settings.checkout_label }} · <span data-lzy-cart-total>$0.00</span></button>
  </aside>
  <div class="lzy-goli-cart-overlay" hidden></div>
</section>

{% schema %}
{
  "name": "Goli Bundle Buy",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Zero Sugar Essentials"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Includes: <strong>Zero Sugar ACV+ , Pre+Post+Probiotics, and Ashwa+ Gummies</strong>"
    },
    {
      "type": "text",
      "id": "sticker_title",
      "label": "Sticker title",
      "default": "Clinician<br>Choice"
    },
    {
      "type": "text",
      "id": "sticker_link_text",
      "label": "Sticker link",
      "default": "Read their reviews"
    },
    {
      "type": "text",
      "id": "review_aria_label",
      "label": "Sticker aria",
      "default": "Read clinician reviews"
    },
    {
      "type": "url",
      "id": "review_url",
      "label": "Review URL",
      "default": "#clinician-reviews"
    },
    {
      "type": "text",
      "id": "pill_text",
      "label": "Pill text",
      "default": "10% OFF & Cancel Anytime"
    },
    {
      "type": "text",
      "id": "each_label",
      "label": "Each label",
      "default": "each"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total:"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout label",
      "default": "CHECKOUT NOW"
    },
    {
      "type": "text",
      "id": "cart_heading",
      "label": "Cart heading",
      "default": "Your Cart"
    },
    {
      "type": "text",
      "id": "cart_empty",
      "label": "Cart empty",
      "default": "Your cart is currently empty."
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Subscribe & Save"
        },
        {
          "type": "text",
          "id": "plan_key",
          "label": "Plan key",
          "default": "subscribe"
        },
        {
          "type": "text",
          "id": "each_price",
          "label": "Each price",
          "default": "$10.13"
        },
        {
          "type": "text",
          "id": "total_price",
          "label": "Total price",
          "default": "$30.38"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare price",
          "default": "$75.00"
        },
        {
          "type": "checkbox",
          "id": "default_selected",
          "label": "Default selected",
          "default": false
        }
      ]
    },
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "3-PACK"
        },
        {
          "type": "checkbox",
          "id": "default_selected",
          "label": "Default selected",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Goli Bundle Buy",
      "blocks": [
        {
          "type": "plan",
          "settings": {
            "label": "Subscribe & Save",
            "plan_key": "subscribe",
            "each_price": "$10.13",
            "total_price": "$30.38",
            "compare_price": "$75.00",
            "default_selected": true
          }
        },
        {
          "type": "plan",
          "settings": {
            "label": "One-time Purchase",
            "plan_key": "onetime",
            "each_price": "$11.25",
            "total_price": "$33.75",
            "compare_price": "$75.00",
            "default_selected": false
          }
        },
        {
          "type": "pack",
          "settings": {
            "label": "3-PACK",
            "default_selected": true
          }
        },
        {
          "type": "pack",
          "settings": {
            "label": "6-PACK",
            "default_selected": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
