{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

<section class="lzy-goli-root lzy-goli-shop-cta" data-lzy-section="shop-cta"><a href="{{ section.settings.url }}">{{ section.settings.label }}</a></section>

{% schema %}
{
  "name": "Goli Editable CTA",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop the Bundle & Save"
    },
    {
      "type": "text",
      "id": "url",
      "label": "URL",
      "default": "#product-target"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Goli Editable CTA",
      "blocks": []
    }
  ]
}
{% endschema %}
