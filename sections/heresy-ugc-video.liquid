{{ 'heresy-shared.css' | asset_url | stylesheet_tag }}
{{ 'heresy-ugc-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'heresy-ugc-video.js' | asset_url }}" defer></script>

<section class="heresy-ugc-video" data-heresy-section="{{ section.id }}" data-heresy-ugc>
  {% if section.settings.heading != blank %}<h2 class="heresy-ugc-video__heading">{{ section.settings.heading }}</h2>{% endif %}
  <div class="heresy-ugc-video__track">
    {% for block in section.blocks %}
      {% assign fallback_asset = block.settings.fallback | prepend: 'heresy-creator-' | append: '.webp' %}
      <article class="heresy-ugc-video__card" {{ block.shopify_attributes }}>
        <div class="heresy-ugc-video__media">
          <div class="heresy-ugc-video__poster" data-heresy-ugc-poster>
            {% if block.settings.poster != blank %}
              {{ block.settings.poster | image_url: width: 2480 | image_tag: class: 'heresy-ugc-video__image', loading: 'lazy', widths: '480, 720, 960, 1280, 1600, 1920, 2480', sizes: '(max-width: 749px) calc(100vw - 32px), calc(100vw - 4.5vw)', alt: block.settings.alt }}
            {% elsif block.settings.poster_url != blank %}
              <img
                src="{{ block.settings.poster_url | escape }}"
                class="heresy-ugc-video__image"
                width="1920"
                height="1080"
                loading="lazy"
                alt="{{ block.settings.alt | escape }}"
              >
            {% else %}
              {% render 'heresy-responsive-image', image: block.settings.poster, fallback_asset: fallback_asset, alt: block.settings.alt, class: 'heresy-ugc-video__image', sizes: '(max-width: 749px) calc(100vw - 24px), calc(100vw - 4.5vw)', width: 1320, height: 1440 %}
            {% endif %}

            {% if block.settings.video != blank or block.settings.video_url != blank %}
              <div class="heresy-ugc-video__play-overlay">
                {% if block.settings.title != blank %}<p class="heresy-ugc-video__play-label">{{ block.settings.title }}</p>{% endif %}
                <button type="button" class="heresy-ugc-video__play" data-heresy-ugc-play aria-label="Play {{ block.settings.title | escape }} video">
                  <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path d="M19.1328 11.0005L0.932812 21.5083L0.932812 0.492746L19.1328 11.0005Z" fill="currentColor"></path></svg>
                </button>
              </div>
            {% endif %}
          </div>
          {% if block.settings.video != blank %}
            {{ block.settings.video | video_tag: class: 'heresy-ugc-video__video', controls: true, loop: false, muted: false, playsinline: true, preload: 'none', image_size: '1280x' }}
          {% elsif block.settings.video_url != blank %}
            <video
              class="heresy-ugc-video__video"
              controls
              playsinline
              preload="none"
              {% if block.settings.poster_url != blank %}poster="{{ block.settings.poster_url | escape }}"{% endif %}
            >
              <source src="{{ block.settings.video_url | escape }}" type="video/mp4">
            </video>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Heresy UGC videos",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading"}
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "settings": [
        {"type": "video", "id": "video", "label": "Shopify-hosted video"},
        {"type": "text", "id": "video_url", "label": "Fallback MP4 URL", "default": "https://cdn.shopify.com/videos/c/vp/16f73615a3344967a8d12dea3e27193f/16f73615a3344967a8d12dea3e27193f.HD-720p-4.5Mbps-41539885.mp4"},
        {"type": "image_picker", "id": "poster", "label": "Poster"},
        {"type": "text", "id": "poster_url", "label": "Fallback poster URL", "default": "https://cdn.shopify.com/s/files/1/0606/5451/8510/files/tolstoy_ba245bce-d442-4cbb-a58f-cb53329aba62_thumbnail_1780334421131.jpg?v=1781167440"},
        {"type": "text", "id": "title", "label": "Play label", "default": "See how HAILEY wears PEPTIDE LIP SHAPE."},
        {"type": "text", "id": "alt", "label": "Poster alt text", "default": "Peptide Lip Shape pencils"},
        {"type": "select", "id": "fallback", "label": "Bundled poster", "options": [
          {"value": "gabbie", "label": "Gabbie"},
          {"value": "bella", "label": "Bella"},
          {"value": "ivy", "label": "Ivy"},
          {"value": "kendall", "label": "Kendall"},
          {"value": "ria", "label": "Ria"}
        ], "default": "gabbie"}
      ]
    }
  ],
  "max_blocks": 1,
  "presets": [
    {
      "name": "Heresy UGC videos",
      "blocks": [
        {"type": "video_card", "settings": {"fallback": "gabbie"}}
      ]
    }
  ]
}
{% endschema %}
