{{ 'heresy-shared.css' | asset_url | stylesheet_tag }}
{{ 'heresy-product-recommendations.css' | asset_url | stylesheet_tag }}
<script src="{{ 'heresy-product-recommendations.js' | asset_url }}" defer></script>

<section
  class="heresy-product-recommendations"
  data-heresy-section="{{ section.id }}"
  data-heresy-recommendations
  {% if section.blocks.size == 0 and recommendations.performed? == false %}data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"{% endif %}
>
  {% liquid
    assign has_cards = false
    if section.blocks.size > 0
      assign has_cards = true
    elsif recommendations.performed? and recommendations.products_count > 0
      assign has_cards = true
    endif
  %}
  {% if has_cards %}
    <div class="heresy-product-recommendations__controls">
      <span>{{ section.settings.swipe_label }}</span>
      <div class="heresy-product-recommendations__arrows">
        <button type="button" data-heresy-recommendations-previous aria-label="Previous products">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M30 10 16 24l14 14M17 24h22" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
        </button>
        <button type="button" data-heresy-recommendations-next aria-label="Next products">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="m18 10 14 14-14 14m13-14H9" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
        </button>
      </div>
    </div>
    <div class="heresy-product-recommendations__track" data-heresy-recommendations-track>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% liquid
            case block.settings.fallback
              when 'brush'
                assign primary_asset = 'heresy-recommend-brush.jpg'
                assign hover_asset = 'heresy-recommend-brush-hover.jpg'
              when 'glazing'
                assign primary_asset = 'heresy-recommend-glazing.jpg'
                assign hover_asset = 'heresy-recommend-glazing-hover.jpg'
              when 'mist'
                assign primary_asset = 'heresy-recommend-mist.jpg'
                assign hover_asset = 'heresy-recommend-mist-hover.jpg'
              when 'lip_case'
                assign primary_asset = 'heresy-recommend-lip-case.jpg'
                assign hover_asset = 'heresy-recommend-lip-case-hover.jpg'
              else
                assign primary_asset = 'heresy-recommend-highlight.jpg'
                assign hover_asset = 'heresy-recommend-highlight-hover.jpg'
            endcase
            assign card_url = block.settings.product.url | default: routes.all_products_collection_url
            assign card_title = block.settings.title | default: block.settings.product.title
            assign card_price = block.settings.price
            if block.settings.product != blank
              assign card_price = block.settings.product.price | money
            endif
          %}
          <article class="heresy-product-recommendations__card" {{ block.shopify_attributes }}>
            <a href="{{ card_url }}">
              <div class="heresy-product-recommendations__image-wrap">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1280 | image_tag: class: 'heresy-product-recommendations__image heresy-product-recommendations__image--primary', loading: 'lazy', widths: '480, 640, 800, 960, 1280', sizes: '(max-width: 749px) 84vw, 31vw', alt: block.settings.image_alt }}
                {% else %}
                  <img class="heresy-product-recommendations__image heresy-product-recommendations__image--primary" src="{{ primary_asset | asset_url }}" loading="lazy" decoding="async" width="1280" height="1280" alt="{{ block.settings.image_alt | escape }}">
                {% endif %}
                {% if block.settings.hover_image != blank %}
                  {{ block.settings.hover_image | image_url: width: 1280 | image_tag: class: 'heresy-product-recommendations__image heresy-product-recommendations__image--hover', loading: 'lazy', widths: '480, 640, 800, 960, 1280', sizes: '(max-width: 749px) 84vw, 31vw', alt: block.settings.hover_alt }}
                {% else %}
                  <img class="heresy-product-recommendations__image heresy-product-recommendations__image--hover" src="{{ hover_asset | asset_url }}" loading="lazy" decoding="async" width="1280" height="1280" alt="{{ block.settings.hover_alt | escape }}">
                {% endif %}
                <span class="heresy-product-recommendations__cta">{{ block.settings.cta_label }} {{ card_title }} - {{ card_price }}</span>
              </div>
              <div class="heresy-product-recommendations__meta">
                <h2>{{ card_title }}</h2>
                <span>{{ card_price }}</span>
              </div>
            </a>
          </article>
        {% endfor %}
      {% else %}
        {% for recommended_product in recommendations.products %}
          <article class="heresy-product-recommendations__card">
            <a href="{{ recommended_product.url }}">
              <div class="heresy-product-recommendations__image-wrap">
                {% if recommended_product.featured_image != blank %}
                  {{ recommended_product.featured_image | image_url: width: 1280 | image_tag: class: 'heresy-product-recommendations__image heresy-product-recommendations__image--primary', loading: 'lazy', widths: '480, 640, 800, 960, 1280', sizes: '(max-width: 749px) 84vw, 31vw', alt: recommended_product.featured_image.alt }}
                  {% if recommended_product.images[1] != blank %}
                    {{ recommended_product.images[1] | image_url: width: 1280 | image_tag: class: 'heresy-product-recommendations__image heresy-product-recommendations__image--hover', loading: 'lazy', widths: '480, 640, 800, 960, 1280', sizes: '(max-width: 749px) 84vw, 31vw', alt: recommended_product.images[1].alt }}
                  {% endif %}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'heresy-product-recommendations__image placeholder-svg' }}
                {% endif %}
                <span class="heresy-product-recommendations__cta">BUY {{ recommended_product.title }} - {{ recommended_product.price | money }}</span>
              </div>
              <div class="heresy-product-recommendations__meta">
                <h2>{{ recommended_product.title }}</h2>
                <span>{{ recommended_product.price | money }}</span>
              </div>
            </a>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  {% elsif section.blocks.size == 0 %}
    <span class="heresy-product-recommendations__loading" aria-live="polite">{{ section.settings.loading_label }}</span>
  {% endif %}
</section>

{% schema %}
{
  "name": "Heresy recommendations",
  "settings": [
    {"type": "text", "id": "heading", "label": "Legacy heading (not displayed)", "default": "you may also like"},
    {"type": "text", "id": "swipe_label", "label": "Swipe label", "default": "swipe"},
    {"type": "text", "id": "loading_label", "label": "Loading label", "default": "Loading recommendations…"},
    {"type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 10, "step": 1, "default": 5}
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {"type": "product", "id": "product", "label": "Product"},
        {"type": "text", "id": "title", "label": "Title", "default": "highlight milk"},
        {"type": "text", "id": "price", "label": "Fallback price", "default": "€37,00"},
        {"type": "text", "id": "cta_label", "label": "CTA label", "default": "BUY"},
        {"type": "image_picker", "id": "image", "label": "Product image"},
        {"type": "text", "id": "image_alt", "label": "Product image alt text", "default": "rhode product"},
        {"type": "image_picker", "id": "hover_image", "label": "Hover image"},
        {"type": "text", "id": "hover_alt", "label": "Hover image alt text", "default": "rhode product in use"},
        {"type": "select", "id": "fallback", "label": "Bundled fallback", "options": [
          {"value": "highlight", "label": "Highlight milk"},
          {"value": "brush", "label": "Pocket brush"},
          {"value": "glazing", "label": "Glazing milk"},
          {"value": "mist", "label": "Glazing mist"},
          {"value": "lip_case", "label": "Snap-on lip case"}
        ], "default": "highlight"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{"name": "Heresy recommendations", "blocks": [
    {"type": "product_card", "settings": {"title": "highlight milk", "price": "€37,00", "fallback": "highlight"}},
    {"type": "product_card", "settings": {"title": "pocket brush", "price": "€36,00", "fallback": "brush"}},
    {"type": "product_card", "settings": {"title": "glazing milk", "price": "€42,00", "fallback": "glazing"}},
    {"type": "product_card", "settings": {"title": "glazing mist", "price": "€39,00", "fallback": "mist"}},
    {"type": "product_card", "settings": {"title": "snap-on lip case", "price": "€60,00", "fallback": "lip_case"}}
  ]}]
}
{% endschema %}
