{{ 'heresy-shared.css' | asset_url | stylesheet_tag }}
{{ 'heresy-product-recommendations.css' | asset_url | stylesheet_tag }}
<script src="{{ 'heresy-product-recommendations.js' | asset_url }}" defer></script>

<section
  class="heresy-product-recommendations"
  data-heresy-section="{{ section.id }}"
  data-heresy-recommendations
  {% if section.blocks.size == 0 and recommendations.performed? == false %}data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"{% endif %}
>
  {% liquid
    assign has_cards = false
    if section.blocks.size > 0
      assign has_cards = true
    elsif recommendations.performed? and recommendations.products_count > 0
      assign has_cards = true
    endif
  %}
  {% if has_cards %}
    <header class="heresy-product-recommendations__header">
      <h2>{{ section.settings.heading }}</h2>
      <span>{{ section.settings.swipe_label }}</span>
    </header>
    <div class="heresy-product-recommendations__track">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign fallback_asset = block.settings.fallback | prepend: 'heresy-routine-' | append: '-model.webp'
            assign defer_recommendation_image = true
          %}
          {% assign card_url = block.settings.product.url | default: routes.all_products_collection_url %}
          <article class="heresy-product-recommendations__card" {{ block.shopify_attributes }}>
            <a href="{{ card_url }}">
              <div class="heresy-product-recommendations__image-wrap">
                {% render 'heresy-responsive-image', image: block.settings.image, fallback_asset: fallback_asset, alt: block.settings.image_alt, class: 'heresy-product-recommendations__image', width: 1120, height: 1222, sizes: '(max-width: 749px) 75vw, 24vw', defer_image: defer_recommendation_image %}
              </div>
              <div class="heresy-product-recommendations__meta">
                <h3>{{ block.settings.title | default: block.settings.product.title }}</h3>
                <span>{% if block.settings.product != blank %}{{ block.settings.product.price | money }}{% else %}{{ block.settings.price }}{% endif %}</span>
              </div>
            </a>
          </article>
        {% endfor %}
      {% else %}
        {% for recommended_product in recommendations.products %}
          <article class="heresy-product-recommendations__card">
            <a href="{{ recommended_product.url }}">
              <div class="heresy-product-recommendations__image-wrap">
                {% if recommended_product.featured_image != blank %}
                  {{ recommended_product.featured_image | image_url: width: 1200 | image_tag: class: 'heresy-product-recommendations__image', loading: 'lazy', widths: '320, 480, 640, 800, 960, 1200', sizes: '(min-width: 990px) 25vw, 75vw', alt: recommended_product.featured_image.alt }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'heresy-product-recommendations__image placeholder-svg' }}
                {% endif %}
              </div>
              <div class="heresy-product-recommendations__meta">
                <h3>{{ recommended_product.title }}</h3>
                <span>{{ recommended_product.price | money }}</span>
              </div>
            </a>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  {% elsif section.blocks.size == 0 %}
    <span class="heresy-product-recommendations__loading" aria-live="polite">{{ section.settings.loading_label }}</span>
  {% endif %}
</section>

{% schema %}
{
  "name": "Heresy recommendations",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "you may also like"},
    {"type": "text", "id": "swipe_label", "label": "Swipe label", "default": "swipe"},
    {"type": "text", "id": "loading_label", "label": "Loading label", "default": "Loading recommendations…"},
    {"type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 10, "step": 1, "default": 4}
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {"type": "product", "id": "product", "label": "Product"},
        {"type": "text", "id": "title", "label": "Title", "default": "peptide lip tint"},
        {"type": "text", "id": "price", "label": "Fallback price", "default": "€20,00"},
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "image_alt", "label": "Image alt text", "default": "rhode skincare product"},
        {"type": "select", "id": "fallback", "label": "Bundled fallback", "options": [{"value": "shape", "label": "Peptide lip shape"}, {"value": "tint", "label": "Peptide lip tint"}, {"value": "blush", "label": "Pocket blush"}, {"value": "bronze", "label": "Pocket bronze"}, {"value": "milk", "label": "Highlight milk"}], "default": "tint"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{"name": "Heresy recommendations", "blocks": [{"type": "product_card", "settings": {"title": "peptide lip tint", "price": "€20,00", "fallback": "tint"}}, {"type": "product_card", "settings": {"title": "pocket blush", "price": "€33,00", "fallback": "blush"}}, {"type": "product_card", "settings": {"title": "pocket bronze", "price": "€33,00", "fallback": "bronze"}}, {"type": "product_card", "settings": {"title": "highlight milk", "price": "€30,00", "fallback": "milk"}}]}]
}
{% endschema %}
