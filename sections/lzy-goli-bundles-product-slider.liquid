{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

<section id="shopify-section-template--18893871677636__slider_3_horizontal_products_aam" class="shopify-section section-brand-aam-product-slider">
  {% if section.settings.show_frontrow_reviews %}
    <section class="fr-testimonials">
      <script async type="text/javascript" src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=qual&product_id={{ section.settings.frontrow_product_id | escape }}"></script>
      <iframe id="frontrow-testimonials" class="iframe-frontrow-testimonials" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=qual&product_id={{ section.settings.frontrow_product_id | escape }}"></iframe>
    </section>
  {% endif %}
  <section id="product_bundle_slider" class="brand-aam-product-slider text-[1vw] 2xl:text-[1rem] py-[2em]">
    <div class="md:text-[.35em] lg:text-[.35em] mx-auto px-[3em] gap-[3em] grid grid-cols-1 md:grid-cols-[85em,85em] lg:grid-cols-[85em,85em,85em] justify-center">
      {% for block in section.blocks %}
        {% if block.type == 'product_card' %}
          <div class="info-b-cont rounded-[2em] flex justify-between flex-col overflow-hidden" style="background-color: {{ block.settings.background_color }};" {{ block.shopify_attributes }}>
            <div class="product-slider-wrapper">
              <div class="swiper product-card-slider-{{ block.id }}">
                <div class="swiper-wrapper">
                  {% for i in (1..3) %}
                    {% assign image_key = 'image_' | append: i %}
                    {% assign image_url_key = image_key | append: '_url' %}
                    {% assign card_image = block.settings[image_url_key] %}
                    {% if block.settings[image_key] != blank %}
                      {% assign card_image = block.settings[image_key] | image_url: width: 600 %}
                    {% endif %}
                    {% if card_image != blank %}
                      <div class="swiper-slide flex items-center justify-center px-[6em] py-[6em]">
                        <div class="slide-image w-full h-full flex items-center justify-center rounded-[3em] overflow-hidden">
                          <img src="{{ card_image }}" alt="{{ block.settings.title | strip_html | escape }}" width="600" height="400" loading="lazy" class="w-full h-full object-cover">
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
                <div class="relative flex justify-center items-center">
                  <div class="swiper-button-prev slide-arrow-{{ block.id }}"></div>
                  <div class="swiper-pagination product-card-pagination-{{ block.id }}"></div>
                  <div class="swiper-button-next slide-arrow-{{ block.id }}"></div>
                </div>
              </div>
            </div>
            <div class="info-text-content p-[6em] text-center flex flex-col justify-between lg:min-h-[90.5em]" style="color: {{ block.settings.text_color }};">
              <h3 class="info-title text-[4.8em] font-extrabold mb-[0.5em]">{{ block.settings.title }}</h3>
              <div class="info-description text-[4em] leading-1 mb-[2em] opacity-80">{{ block.settings.description | newline_to_br }}</div>
              <div>
                <div class="flex justify-center">
                  <h4 class="info-title-2 text-[4.4em] justify-center font-extrabold mb-[0.5em] rounded-[.5em] flex w-[10em] py-[0.5em] text-white" style="background-color: {{ block.settings.accent_color }};">Helps support:</h4>
                </div>
                <ul class="support-list flex flex-col font-extrabold text-[4em] items-center list-disc list-inside space-y-1">
                  {% assign support_items = block.settings.support_items | newline_to_br | split: '<br />' %}
                  {% for item in support_items %}
                    {% if item != blank %}<li class="support-list-item leading-[1em]">{{ item }}</li>{% endif %}
                  {% endfor %}
                </ul>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  <section x-data="" class="flex justify-center text-[1vw] pt-[3em] 2xl:text-[1rem]" @click="alpineScrollTo('product-target')">
    <button class="bg-black text-white text-[4em] md:text-[1.5em] py-[1em] px-[4em] inline-block font-bold">{{ section.settings.button_label }}</button>
  </section>
</section>

{% schema %}
{
  "name": "Goli Product Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_frontrow_reviews",
      "label": "Show Frontrow reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "frontrow_product_id",
      "label": "Frontrow product ID",
      "default": "3284"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Bundle & Save"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Zero Sugar Gummies"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Product description."
        },
        {
          "type": "textarea",
          "id": "support_items",
          "label": "Support items",
          "default": "Digestive Health"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#d7f6ff"
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Accent color",
          "default": "#00a9e0"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1"
        },
        {
          "type": "text",
          "id": "image_1_url",
          "label": "Image 1 fallback URL",
          "default": "https://goli.com/cdn/shop/files/tt-zs-ash-listing-2-v2.jpg?v=1753707479&width=600"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        },
        {
          "type": "text",
          "id": "image_2_url",
          "label": "Image 2 fallback URL",
          "default": "https://goli.com/cdn/shop/files/tt-zs-ash-listing-3-v2.jpg?v=1753707479&width=600"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3"
        },
        {
          "type": "text",
          "id": "image_3_url",
          "label": "Image 3 fallback URL",
          "default": "https://goli.com/cdn/shop/files/tt-zs-ash-listing-9-v2.jpg?v=1753707481&width=600"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Goli Product Slider"
    }
  ]
}
{% endschema %}
