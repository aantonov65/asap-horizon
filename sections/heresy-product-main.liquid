{{ 'heresy-shared.css' | asset_url | stylesheet_tag }}
{{ 'heresy-product-main.css' | asset_url | stylesheet_tag }}
<script src="{{ 'heresy-media-loader.js' | asset_url }}" defer></script>
<script src="{{ 'heresy-product-main.js' | asset_url }}" defer></script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'heresy-product-form-' | append: section.id
  assign media_blocks = section.blocks | where: 'type', 'media'
  assign routine_blocks = section.blocks | where: 'type', 'routine_item'
  assign upsell_blocks = section.blocks | where: 'type', 'upsell_item'
  assign tab_blocks = section.blocks | where: 'type', 'tab'
%}

<section
  class="heresy-product-main"
  id="heresy-product-main-{{ section.id }}"
  data-heresy-section="{{ section.id }}"
  data-heresy-product
  data-add-label="{{ section.settings.add_to_cart_label | escape }}"
  data-sold-out-label="{{ section.settings.sold_out_label | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
>
  <div class="heresy-product-main__layout">
    <div class="Product-slider heresy-product-main__gallery" data-heresy-product-gallery>
      <div class="Product-slider-thumbnails" aria-label="{{ 'Products media' | escape }}">
        {% for block in media_blocks %}
          {% liquid
            assign thumbnail = block.settings.image
            assign is_video_thumbnail = false
            if block.settings.video != blank
              assign thumbnail = block.settings.video.preview_image
              assign is_video_thumbnail = true
            elsif block.settings.mobile_video != blank
              assign thumbnail = block.settings.mobile_video.preview_image
              assign is_video_thumbnail = true
            endif
            case block.settings.fallback
              when 'hero_1'
                assign fallback_thumbnail = 'heresy-product-hero-1-desktop.webp'
              when 'hero_2'
                assign fallback_thumbnail = 'heresy-product-hero-2-desktop.webp'
              when 'video_1'
                assign fallback_thumbnail = 'heresy-product-video-1-poster.jpg'
                assign is_video_thumbnail = true
              else
                assign fallback_thumbnail = 'heresy-product-video-2-poster.jpg'
                assign is_video_thumbnail = true
            endcase
          %}
          <button
            type="button"
            class="Product-slider-thumbnail js-slider-navigation{% if is_video_thumbnail %} heresy-product-main__thumbnail--video{% endif %}{% if forloop.first %} Product-slider-thumbnail__active{% endif %}"
            data-heresy-media-button="{{ forloop.index0 }}"
            aria-label="Show media {{ forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {% unless is_video_thumbnail %}
              {% render 'heresy-responsive-image', image: thumbnail, fallback_asset: fallback_thumbnail, alt: block.settings.alt, class: 'heresy-product-main__thumbnail-image', sizes: '80px', width: 160, height: 160 %}
            {% endunless %}
          </button>
        {% endfor %}
      </div>

      <div class="heresy-product-main__media-track">
        {% for block in media_blocks %}
          {% liquid
            assign fallback_video_desktop = blank
            assign fallback_video_mobile = blank
            case block.settings.fallback
              when 'hero_1'
                assign fallback_desktop = 'heresy-product-hero-1-desktop.webp'
                assign fallback_mobile = 'heresy-product-hero-1-mobile.webp'
                assign fallback_width = 1600
                assign fallback_height = 1329
              when 'hero_2'
                assign fallback_desktop = 'heresy-product-hero-2-desktop.webp'
                assign fallback_mobile = 'heresy-product-hero-2-mobile.webp'
                assign fallback_width = 1600
                assign fallback_height = 1329
              when 'video_1'
                assign fallback_desktop = 'heresy-product-video-1-poster.jpg'
                assign fallback_mobile = fallback_desktop
                assign fallback_video_desktop = 'heresy-product-gallery-3-desktop.mp4'
                assign fallback_video_mobile = 'heresy-product-gallery-3-mobile.mp4'
                assign fallback_width = 100
                assign fallback_height = 100
              else
                assign fallback_desktop = 'heresy-product-video-2-poster.jpg'
                assign fallback_mobile = fallback_desktop
                assign fallback_video_desktop = 'heresy-product-gallery-4-desktop.mp4'
                assign fallback_video_mobile = 'heresy-product-gallery-4-mobile.mp4'
                assign fallback_width = 100
                assign fallback_height = 100
            endcase
          %}
          <div
            class="Product-slider-image-container heresy-product-main__media{% if block.settings.mobile_video != blank or fallback_video_mobile != blank %} heresy-has-mobile-video{% endif %}{% if forloop.first %} heresy-is-active{% endif %}"
            data-heresy-media="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.video != blank or block.settings.mobile_video != blank or fallback_video_desktop != blank %}
              {% if block.settings.video != blank %}
                {{ block.settings.video | video_tag: class: 'Product-video heresy-product-main__video heresy-product-main__video--desktop', loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '1600x' }}
              {% elsif fallback_video_desktop != blank %}
                <video class="Product-video heresy-product-main__video heresy-product-main__video--desktop" loop muted playsinline preload="none" aria-label="{{ block.settings.alt | escape }}">
                  <source src="{{ fallback_video_desktop | file_url }}" type="video/mp4">
                </video>
              {% else %}
                <img src="{{ fallback_desktop | asset_url }}" class="heresy-product-main__hero-image heresy-product-main__video--desktop" width="{{ fallback_width }}" height="{{ fallback_height }}" loading="lazy" alt="{{ block.settings.alt | escape }}">
              {% endif %}
              {% if block.settings.mobile_video != blank %}
                {{ block.settings.mobile_video | video_tag: class: 'Product-video heresy-product-main__video heresy-product-main__video--mobile', loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '1024x' }}
              {% elsif fallback_video_mobile != blank %}
                <video class="Product-video heresy-product-main__video heresy-product-main__video--mobile" loop muted playsinline preload="none" aria-label="{{ block.settings.alt | escape }}">
                  <source src="{{ fallback_video_mobile | file_url }}" type="video/mp4">
                </video>
              {% endif %}
            {% elsif block.settings.image != blank %}
              <picture>
                {% if block.settings.mobile_image != blank %}
                  <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 1024 }}">
                {% endif %}
                {% if forloop.first %}
                  {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'heresy-product-main__hero-image', loading: 'eager', fetchpriority: 'high', decoding: 'async', widths: '640, 960, 1280, 1600, 2000', sizes: '(min-width: 990px) 67vw, 100vw', alt: block.settings.alt }}
                {% else %}
                  {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'heresy-product-main__hero-image', loading: 'lazy', fetchpriority: 'low', decoding: 'async', widths: '640, 960, 1280, 1600, 2000', sizes: '(min-width: 990px) 67vw, 100vw', alt: block.settings.alt }}
                {% endif %}
              </picture>
            {% else %}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ fallback_mobile | asset_url }}">
                <img
                  src="{{ fallback_desktop | asset_url }}"
                  class="heresy-product-main__hero-image"
                  width="{{ fallback_width }}"
                  height="{{ fallback_height }}"
                  {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
                  {% if forloop.first %}fetchpriority="high"{% else %}fetchpriority="low"{% endif %}
                  decoding="async"
                  alt="{{ block.settings.alt | escape }}"
                >
              </picture>
            {% endif %}
          </div>
        {% else %}
          <div class="Product-slider-image-container heresy-product-main__media heresy-is-active">
            {% render 'heresy-responsive-image', image: product.featured_image, fallback_asset: 'heresy-product-hero-1-desktop.webp', alt: product.title, class: 'heresy-product-main__hero-image', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 67vw, 100vw', width: 1600, height: 1329 %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="heresy-product-main__card">
      {% if section.settings.eyebrow != blank %}<p class="heresy-product-main__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1 class="u-fontRektorat u-hSize--Medium Product-main-card-title">{{ section.settings.title | default: product.title }}</h1>
      <div class="Product-main-card-content-price-container u-noMargin">
        <div class="Product-main-card-subtitle">
          <div class="Product-main-card-subtitle-inner">
            <strong>{{ section.settings.subtitle }}</strong>
            {% if section.settings.show_reviews %}
              <span class="Product-review-score-short heresy-product-main__reviews" aria-label="5 out of 5 stars, {{ section.settings.review_count }} reviews">
                <span class="heresy-product-main__stars" aria-hidden="true">★★★★★</span>
                <span>({{ section.settings.review_count }})</span>
              </span>
            {% endif %}
          </div>
        </div>
      </div>

      {% if section.settings.use_product_description %}
        <div class="Product-main-card-description u-pSize rte">{{ product.description }}</div>
      {% elsif section.settings.description != blank %}
        <div class="Product-main-card-description u-pSize rte">{{ section.settings.description }}</div>
      {% endif %}

      {% form 'product', product, id: product_form_id, class: 'heresy-product-main__form', novalidate: 'novalidate' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-heresy-variant-id>
        <input type="hidden" name="quantity" value="1" data-heresy-quantity-input>

        {% unless product.has_only_default_variant %}
          <div class="Product-swatches-container js-product-swatches-container" data-heresy-options>
            {% for option in product.options_with_values %}
              <fieldset class="heresy-product-main__option" data-heresy-option="{{ option.position | minus: 1 }}">
                <legend class="Product-swatches-container-title u-pSize u-noMargin">
                  {{ option.name }}:
                  <span data-heresy-option-label="{{ option.position | minus: 1 }}">{{ option.selected_value }}</span>
                </legend>
                <div class="Product-swatches-popup__group" role="list">
                  {% for value in option.values %}
                    {% liquid
                      assign swatch_color = '#b68574'
                      assign normalized_value = value | downcase
                      case normalized_value
                        when 'lift'
                          assign swatch_color = '#c18d93'
                        when 'push'
                          assign swatch_color = '#b68574'
                        when 'press'
                          assign swatch_color = '#be7984'
                        when 'bend'
                          assign swatch_color = '#b6806a'
                        when 'squeeze'
                          assign swatch_color = '#bb7055'
                        when 'lunge'
                          assign swatch_color = '#ab7265'
                        when 'twist'
                          assign swatch_color = '#a57462'
                        when 'balance'
                          assign swatch_color = '#906650'
                        when 'lean'
                          assign swatch_color = '#96665d'
                        when 'jump'
                          assign swatch_color = '#874936'
                        when 'stretch'
                          assign swatch_color = '#81594a'
                        when 'flex'
                          assign swatch_color = '#5c4237'
                        when 'spin'
                          assign swatch_color = '#4c3941'
                        when 'move'
                          assign swatch_color = '#463832'
                      endcase
                    %}
                    <button
                      type="button"
                      class="heresy-product-main__option-value{% if value.selected %} heresy-is-selected{% endif %}"
                      data-heresy-option-value="{{ value | escape }}"
                      aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"
                      role="listitem"
                    >
                      <span class="Product-swatches-popup-color" style="background-color: {{ swatch_color }};"></span>
                      <span>{{ value }}</span>
                    </button>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
        {% else %}
          <div class="Product-swatches-container heresy-product-main__shade" data-show-swatches="false">
            <div class="Product-swatches-wrapper">
              <div class="Product-swatches-container-titleRow">
                <p class="Product-swatches-container-title u-pSize u-noMargin">
                  {{ section.settings.shade_label }}:
                  <span class="Product-swatches-container-info">
                    <span class="Product-swatches-popup-color" style="background-color: {{ section.settings.shade_color }};"></span>
                    <b>{{ section.settings.shade_name }} -</b>
                    <span class="Product-swatches-description">{{ section.settings.shade_description }}</span>
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                      <path d="M4.29296 5.292 0.707479 1.70717C0.0774266 1.07723.523574 0 1.41452 0h7.17096c.89095 0 1.33709 1.07723.70704 1.70717L5.70704 5.292a1 1 0 0 1-1.41408 0Z" fill="currentColor"/>
                    </svg>
                  </span>
                </p>
              </div>
              <button type="button" class="Product-swatches-shades" data-heresy-shade-jump>{{ section.settings.meet_shades_label }}</button>
            </div>
          </div>
        {% endunless %}

        {% if section.settings.show_quantity %}
          <div class="heresy-product-main__quantity" data-heresy-quantity>
            <span>{{ section.settings.quantity_label }}</span>
            <button type="button" data-heresy-quantity-change="-1" aria-label="Decrease quantity">−</button>
            <output data-heresy-quantity-output>1</output>
            <button type="button" data-heresy-quantity-change="1" aria-label="Increase quantity">+</button>
          </div>
        {% endif %}

        <div class="Product-main-card-cta js-sticky-bar-trigger js-available">
          <button
            type="submit"
            name="add"
            class="Button Button--primary heresy-product-main__add"
            data-heresy-add-button
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-heresy-add-label>{% if current_variant.available %}{{ section.settings.add_to_cart_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span>
            <span aria-hidden="true">—</span>
            <span data-heresy-product-price>{{ current_variant.price | money }}</span>
          </button>
        </div>
      {% endform %}

      {% if routine_blocks.size > 0 %}
        <div class="heresy-complete-routine" data-heresy-routine>
          <div class="heresy-complete-routine__container">
            <h2 class="heresy-complete-routine__title u-pSize u-bold">{{ section.settings.routine_heading }}</h2>
            <div class="heresy-complete-routine__grid">
              {% for block in routine_blocks %}
                {% liquid
                  assign routine_product = block.settings.product
                  assign routine_variant = routine_product.selected_or_first_available_variant
                  assign routine_title = block.settings.title
                  assign routine_price = block.settings.price
                  assign routine_price_cents = block.settings.price_cents
                  assign routine_image = block.settings.image
                  if routine_product != blank
                    if routine_title == blank
                      assign routine_title = routine_product.title
                    endif
                    assign routine_price = routine_variant.price | money
                    assign routine_price_cents = routine_variant.price
                    if routine_image == blank
                      assign routine_image = routine_variant.featured_image | default: routine_product.featured_image
                    endif
                  endif
                  case block.settings.fallback_image
                    when 'sweet_pea'
                      assign routine_fallback = 'heresy-routine-sweet-pea.png'
                    when 'piggy'
                      assign routine_fallback = 'heresy-routine-piggy.png'
                    when 'pebble'
                      assign routine_fallback = 'heresy-routine-pebble.png'
                    else
                      assign routine_fallback = 'heresy-routine-mirror.png'
                  endcase
                %}
                <article
                  class="heresy-complete-routine__card"
                  data-heresy-routine-card
                  data-price-cents="{{ routine_price_cents }}"
                  data-variant-id="{{ routine_variant.id }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="heresy-complete-routine__card-inner">
                    <label class="heresy-complete-routine__checkbox-wrap">
                      <input class="heresy-complete-routine__checkbox-input" type="checkbox" data-heresy-routine-checkbox aria-label="Include {{ routine_title | escape }}">
                      <span class="heresy-complete-routine__checkbox-box" aria-hidden="true">
                        <svg width="13" height="9" viewBox="0 0 13 9" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.753.146a.5.5 0 0 1 .707 0l.707.707a.5.5 0 0 1 0 .708L5.096 8.632a.5.5 0 0 1-.708 0L.146 4.389a.5.5 0 0 1 0-.707l.707-.707a.5.5 0 0 1 .708 0l3.181 3.181L10.753.146Z" fill="white"/></svg>
                      </span>
                    </label>
                    <div class="heresy-complete-routine__card-image">
                      {% if routine_image != blank %}
                        {{ routine_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '120, 200, 300, 400', sizes: '80px', alt: routine_title }}
                      {% else %}
                        <img src="{{ routine_fallback | asset_url }}" width="200" height="200" loading="lazy" alt="{{ routine_title | escape }}">
                      {% endif %}
                    </div>
                    <div class="heresy-complete-routine__card-body">
                      <p class="heresy-complete-routine__card-title">{{ routine_title }}</p>
                      <p class="heresy-complete-routine__card-subtitle">{{ block.settings.subtitle }}</p>
                      <div class="heresy-complete-routine__price-row">
                        <p class="heresy-complete-routine__card-price">{{ routine_price }}</p>
                        {% if block.settings.variant_label != blank %}
                          <div class="heresy-complete-routine__dropdown-wrap">
                            <button class="heresy-complete-routine__dropdown" type="button" data-heresy-routine-dropdown aria-expanded="false">
                              <span>{{ block.settings.variant_label }}</span>
                              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M4.29 5.29.707 1.707A1 1 0 0 1 1.41 0h7.18a1 1 0 0 1 .7 1.707L5.71 5.29a1 1 0 0 1-1.42 0Z" fill="currentColor"/></svg>
                            </button>
                            {% if routine_product != blank and routine_product.variants.size > 1 %}
                              <div class="heresy-complete-routine__variant-panel" data-heresy-routine-variant-panel hidden>
                                {% for variant in routine_product.variants limit: 50 %}
                                  <button type="button" class="heresy-complete-routine__variant-option" data-heresy-routine-variant="{{ variant.id }}" data-price-cents="{{ variant.price }}" data-price="{{ variant.price | money }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</button>
                                {% endfor %}
                              </div>
                            {% endif %}
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </article>
              {% endfor %}
            </div>
            <div class="heresy-complete-routine__footer">
              <button type="button" class="heresy-complete-routine__add" data-heresy-routine-add disabled>{{ section.settings.routine_select_label }}</button>
            </div>
          </div>
        </div>
      {% endif %}

      {% if upsell_blocks.size > 0 %}
        <div class="Product__upsell__wrapper" data-heresy-upsells>
          <div class="Product__upsell__header" role="tablist" aria-label="Product sets">
            {% for block in upsell_blocks %}
              {% unless forloop.first %}<span aria-hidden="true">—</span>{% endunless %}
              <button type="button" class="u-pSize Product__upsell__header__toggle{% if forloop.first %} Product__upsell__header__toggle__active{% endif %}" data-heresy-upsell-tab="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ block.settings.tab_label }}</button>
            {% endfor %}
            <span class="Product__upsell__header__indicator" data-heresy-upsell-indicator></span>
          </div>
          {% for block in upsell_blocks %}
            {% liquid
              assign upsell_product = block.settings.product
              assign upsell_variant = upsell_product.selected_or_first_available_variant
              assign upsell_title = block.settings.title
              assign upsell_price = block.settings.price
              assign upsell_image = block.settings.image
              assign upsell_url = block.settings.url
              if upsell_product != blank
                if upsell_title == blank
                  assign upsell_title = upsell_product.title
                endif
                assign upsell_price = upsell_variant.price | money
                assign upsell_url = upsell_product.url
                if upsell_image == blank
                  assign upsell_image = upsell_product.featured_image
                endif
              endif
              if block.settings.fallback_image == 'mirror'
                assign upsell_fallback = 'heresy-routine-mirror.png'
              else
                assign upsell_fallback = 'heresy-upsell-lip-combos.png'
              endif
            %}
            <div class="heresy-product-main__upsell-panel{% unless forloop.first %} heresy-is-hidden{% endunless %}" data-heresy-upsell-panel="{{ forloop.index0 }}" role="tabpanel" {{ block.shopify_attributes }}>
              <div class="Product__upsell">
                <div class="Product__upsell__image">
                  {% if upsell_image != blank %}
                    {{ upsell_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '120, 200, 300, 400', sizes: '80px', alt: upsell_title }}
                  {% else %}
                    <img src="{{ upsell_fallback | asset_url }}" width="300" height="300" loading="lazy" alt="{{ upsell_title | escape }}">
                  {% endif %}
                </div>
                <div class="Product__upsell__content">
                  <div class="Product__upsell__info"><p class="Product__upsell__info__title u-bold">{{ upsell_title }}</p></div>
                  <div class="Button-container">
                    <a class="Button heresy-product-main__upsell-cta" href="{{ upsell_url | default: '#' }}">{{ block.settings.cta_label }}&nbsp;-&nbsp;<strong>{{ upsell_price }}</strong></a>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if tab_blocks.size > 0 %}
        <div class="Product-tabs">
          {% for block in tab_blocks %}
            <details class="Product-tab" data-heresy-accordion {{ block.shopify_attributes }}>
              <summary class="Product-tab-toggle-container" aria-expanded="false">
                <span>{{ block.settings.heading }}</span>
                <span class="Product-tab-toggle" aria-hidden="true"></span>
              </summary>
              <div class="u-pSize Product-tab-content-container" role="region">
                <div class="u-pSize Product-tab-content rte">{{ block.settings.content }}</div>
                {% if block.settings.link_label != blank %}<a class="Button heresy-product-main__tab-link" href="{{ block.settings.link | default: '#ingredients' }}">{{ block.settings.link_label }}</a>{% endif %}
              </div>
            </details>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if section.settings.enable_sticky_bar %}
    <div class="Product-sticky-bar js-sticky-bar" data-heresy-sticky-bar>
      <div class="Product-sticky-bar-content-container">
        <div class="Product-sticky-bar-content">
          <div>
            <strong>{{ product.title }}</strong>
            <span data-heresy-sticky-variant>{{ current_variant.title }}</span>
          </div>
          <div class="Product-sticky-cta js-available">
            <button
              type="submit"
              form="{{ product_form_id }}"
              name="add"
              class="Button Button--primary"
              data-heresy-sticky-add
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-heresy-sticky-label>{% if current_variant.available %}{{ section.settings.add_to_cart_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</span>
              <span aria-hidden="true">—</span>
              <span data-heresy-product-price>{{ current_variant.price | money }}</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <script type="application/json" data-heresy-product-variants>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "available": {{ variant.available | json }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price | json }},
          "formatted_price": {{ variant.price | money | json }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
          "formatted_compare_at_price": {% if variant.compare_at_price != blank %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Heresy product main",
  "tag": "section",
  "class": "heresy-product-main-section",
