<section id="shopify-section-template--18893871677636__footer_logos_aam" class="shopify-section section-brand-aam-footer-logos">
  <section class="px-[1em] py-8 text=[1vw] 2xl:text-[1rem]">
    <div class="2xl:flex justify-center">
      <div class="grid grid-cols-2 lg:grid-cols-3 2xl:w-[90em] justify-center items-center py-[1em] rounded-[1em]" style="background-color: {{ section.settings.background_color }};">
        {% for block in section.blocks %}
          {% if block.type == 'logo' %}
            {% assign logo_image = block.settings.image_url %}
            {% if block.settings.image != blank %}{% assign logo_image = block.settings.image | image_url: width: 400 %}{% endif %}
            <div class="flex justify-center items-center {% if block.settings.wide_mobile %}col-span-2 lg:col-span-1{% endif %}" {{ block.shopify_attributes }}>
              <img src="{{ logo_image }}" alt="{{ block.settings.alt | escape }}" class="object-contain w-[10em] lg:w-[14em]" width="120" height="80" loading="lazy">
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
</section>

{% schema %}
{
  "name": "Goli Partner Logos",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Fallback logo URL",
          "default": "https://goli.com/cdn/shop/files/aam-bcorp-certified.png?v=1753393253"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Certification logo"
        },
        {
          "type": "checkbox",
          "id": "wide_mobile",
          "label": "Span two columns on mobile",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Goli Partner Logos"
    }
  ]
}
{% endschema %}
