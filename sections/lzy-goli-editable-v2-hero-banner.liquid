{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

<section class="lzy-goli-root lzy-goli-hero" id="top" data-lzy-section="hero-banner">
  <a href="{{ section.settings.cta_url }}" aria-label="{{ section.settings.cta_aria_label }}">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | image_url: width: 2880 }}" width="2880" height="1000" alt="{{ section.settings.cta_aria_label | escape }}" loading="eager">
    {% else %}
      <img src="data:image/jpeg;base64," width="2880" height="1000" alt="Over 60% off Goli zero sugar essentials promotion" loading="eager">
    {% endif %}
  </a>
</section>

{% schema %}
{
  "name": "Goli Editable V2 Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "CTA URL",
      "default": "#product-target"
    },
    {
      "type": "text",
      "id": "cta_aria_label",
      "label": "CTA aria label",
      "default": "Shop the Zero Sugar Essentials bundle"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Goli Editable V2 Hero",
      "blocks": []
    }
  ]
}
{% endschema %}
