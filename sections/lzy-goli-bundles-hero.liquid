{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}

<div id="shopify-section-template--18893871677636__brand_aam_header_zs_2_C9HkXm" class="shopify-section">
  <div id="home-banner" x-data="{}" @click="alpineScrollTo('product-target')">
    <div>
      <div class="relative">
        {% if section.settings.show_frontrow_sticker %}
          <div class="frontrow-desktop-only">
            <script async type="text/javascript" src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=sticker&product_id={{ section.settings.frontrow_product_id | escape }}"></script>
            <iframe data-state="max" class="iframe-frontrow-sticker" id="frontrow-sticker" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=sticker&product_id={{ section.settings.frontrow_product_id | escape }}"></iframe>
          </div>
        {% endif %}
        {% assign lzy_mobile_image = section.settings.mobile_image_url %}
        {% if section.settings.mobile_image != blank %}
          {% assign lzy_mobile_image = section.settings.mobile_image | image_url: width: 900 %}
        {% endif %}
        <picture class="image-wrapper">
          <source media="(max-width: 767px)" srcset="{{ lzy_mobile_image }} 1x" type="image/webp">
          <source media="(min-width: 768px)" srcset="{{ section.settings.desktop_image_url }} 1x" type="image/webp">
          <img src="{{ lzy_mobile_image }}" width="1920" height="800" fetchpriority="high" alt="{{ section.settings.image_alt | escape }}" class="2xl:w-[100%]" loading="lazy">
        </picture>
      </div>
    </div>
  </div>
  {% if section.settings.show_frontrow_sticker %}
    <div class="frontrow-mobile-only" style="margin: -8px 0px 12px 0px">
      <script async type="text/javascript" src="https://app.thefrontrowhealth.com/api/widgets/script?presentation_type=sticker&product_id={{ section.settings.frontrow_product_id | escape }}"></script>
      <iframe data-state="max" class="iframe-frontrow-sticker" id="frontrow-sticker" frameborder="0" src="https://app.thefrontrowhealth.com/api/widgets?presentation_type=sticker&product_id={{ section.settings.frontrow_product_id | escape }}"></iframe>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Goli Bundles Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile hero image"
    },
    {
      "type": "text",
      "id": "mobile_image_url",
      "label": "Mobile fallback image URL",
      "default": "https://goli.com/cdn/shop/files/EVERGREENQ12026-Home-MOBILE.jpg?v=1771024088&width=450"
    },
    {
      "type": "text",
      "id": "desktop_image_url",
      "label": "Desktop fallback image URL",
      "default": "https://goli.com/cdn/shop/files/EVERGREENQ12026-Home-DESKTOP.jpg?v=1771024138&width=5760"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Promotional Banner"
    },
    {
      "type": "checkbox",
      "id": "show_frontrow_sticker",
      "label": "Show Frontrow sticker",
      "default": true
    },
    {
      "type": "text",
      "id": "frontrow_product_id",
      "label": "Frontrow product ID",
      "default": "3283"
    }
  ],
  "presets": [
    {
      "name": "Goli Bundles Hero"
    }
  ]
}
{% endschema %}
