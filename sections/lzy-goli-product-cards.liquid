<section class="lzy-goli-root lzy-goli-products" data-lzy-section="product-cards">
  <div class="lzy-goli-product-grid">
    {% for block in section.blocks %}
      {% assign card_images = block.settings.image_files | split: ',' %}
      {% assign first_image = card_images.first | strip %}
      <article class="lzy-goli-product-card lzy-goli-product-card-{{ block.settings.variant }}" data-lzy-product-slider {{ block.shopify_attributes }}>
        <div class="lzy-goli-product-image">
          <img src="{{ first_image | asset_url }}" data-images="{% for image_file in card_images %}{{ image_file | strip | asset_url }}{% unless forloop.last %},{% endunless %}{% endfor %}" width="600" height="600" alt="{{ block.settings.title | strip_html }}" loading="lazy">
          <div class="lzy-goli-slider-controls"><button class="lzy-goli-slider-arrow lzy-goli-slider-prev" type="button" aria-label="Previous image">‹</button><div class="lzy-goli-slider-dots" aria-label="Image slide controls"></div><button class="lzy-goli-slider-arrow lzy-goli-slider-next" type="button" aria-label="Next image">›</button></div>
        </div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.copy }}</p>
        <strong>{{ block.settings.support_label }}</strong>
        <ul><li>{{ block.settings.support_1 }}</li><li>{{ block.settings.support_2 }}</li><li>{{ block.settings.support_3 }}</li></ul>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Goli Product Cards",
  "settings": [],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
