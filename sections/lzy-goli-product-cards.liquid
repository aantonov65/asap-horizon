            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "red",
              "label": "Red"
            },
            {
              "value": "green",
              "label": "Green"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Zero Sugar<br>Ashwagandha+ Gummies"
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Copy",
          "default": "Made with clinically studied KSM-66® Ashwagandha, L-Theanine, and Maca to help reduce stress, support sleep quality, and enhance focus — all in a delicious zero sugar gummy you’ll enjoy adding to your routine."
        },
        {
          "type": "text",
          "id": "support_label",
          "label": "Support label",
          "default": "Helps support:"
        },
        {
          "type": "text",
          "id": "support_1",
          "label": "Support 1",
          "default": "Stress Relief & Relaxation"
        },
        {
          "type": "text",
          "id": "support_2",
