            "support_3": "Focus & Cognitive Health",
            "image_files": "product-ash-1.jpg,product-ash-2.jpg,product-ash-3.jpg,product-ash-4.jpg,product-ash-5.jpg,product-ash-6.jpg,product-ash-7.jpg,product-ash-8.jpg,product-ash-9.jpg,product-ash-10.jpg"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "variant": "red",
