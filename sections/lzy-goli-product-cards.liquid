{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}

<section class="lzy-goli-cards">
  <div class="lzy-goli-cards__grid">
    {% for block in section.blocks %}
      {% if block.type == 'product_card' %}
        <article class="lzy-goli-card" style="--lzy-card-bg: {{ block.settings.background_color }}; --lzy-card-accent: {{ block.settings.accent_color }};" {{ block.shopify_attributes }}>
          <div class="lzy-goli-card__media">
            {% for index in (1..3) %}
              {% assign image_key = 'image_' | append: index %}
              {% assign url_key = image_key | append: '_url' %}
              {% assign card_image = block.settings[url_key] %}
              {% if block.settings[image_key] != blank %}
                {% assign card_image = block.settings[image_key] | image_url: width: 700 %}
              {% endif %}
              {% if card_image != blank %}
                <img src="{{ card_image }}" alt="{{ block.settings.title | strip_html | escape }}" loading="lazy" width="600" height="420">
                {% break %}
              {% endif %}
            {% endfor %}
          </div>
          <div class="lzy-goli-card__body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            <div class="lzy-goli-card__support">Helps support:</div>
            <ul>
              {% assign items = block.settings.support_items | newline_to_br | split: '<br />' %}
              {% for item in items %}
                {% if item != blank %}<li>{{ item }}</li>{% endif %}
              {% endfor %}
            </ul>
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

