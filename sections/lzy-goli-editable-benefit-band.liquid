{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

<section class="lzy-goli-root lzy-goli-benefit-band" data-lzy-section="benefit-band">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.copy }}</p>
</section>

{% schema %}
{
  "name": "Goli Editable Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why You’ll Love This Bundle"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Three powerful formulas. Zero sugar. One clean routine to support digestion, stress relief, and immune health — every day, without compromise."
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Goli Editable Benefits",
      "blocks": []
    }
  ]
}
{% endschema %}
