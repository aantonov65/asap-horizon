{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lzy-sections.js' | asset_url }}" defer="defer"></script>

<section class="lzy-goli-root lzy-goli-clinician-reviews" id="clinician-reviews" data-lzy-section="clinician-reviews">
  <div class="lzy-goli-clinician-inner">
    <div class="lzy-goli-clinician-label"><span></span><strong>{{ section.settings.label }}</strong><span></span></div>
    <h2>{{ section.settings.heading }}</h2>
    <p class="lzy-goli-clinician-subtitle">{{ section.settings.subtitle }}</p>
    <div class="lzy-goli-review-list">
      {% for block in section.blocks %}
        <article class="lzy-goli-review-card" {{ block.shopify_attributes }}>
          <aside class="lzy-goli-review-provider">
            <div class="lzy-goli-provider-row">
              {% if block.settings.avatar_image != blank %}
                <img src="{{ block.settings.avatar_image | image_url: width: 100 }}" width="100" height="100" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% elsif block.settings.use_initials %}
                <div class="lzy-goli-provider-initials">{{ block.settings.initials }}</div>
              {% else %}
                <img src="data:image/jpeg;base64," width="100" height="100" alt="Dr. Suryadutt Venkat" loading="lazy">
              {% endif %}
              <div><h3>{{ block.settings.name }}</h3><p>{{ block.settings.credential }} <span aria-hidden="true">●</span></p></div>
            </div>
            <dl><div><dt>Specialty</dt><dd>{{ block.settings.specialty }}</dd></div><div><dt>Years in practice</dt><dd>{{ block.settings.years }}</dd></div></dl>
          </aside>
          <div class="lzy-goli-review-copy">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.review }}</p>
            <button type="button" data-lzy-expand-review>{{ section.settings.show_more_label }}</button>
            <div class="lzy-goli-review-highlights"><strong>Highlights:</strong><span>{{ block.settings.highlight_1 }}</span><span>{{ block.settings.highlight_2 }}</span><span>{{ block.settings.highlight_3 }}</span></div>
          </div>
        </article>
      {% endfor %}
    </div>
    <footer class="lzy-goli-review-footer"><button type="button">{{ section.settings.read_more_label }}</button><p>{{ section.settings.powered_by }}</p></footer>
    <p class="lzy-goli-review-disclaimer">{{ section.settings.disclaimer }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Goli Editable Reviews",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Clinician Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Independent Clinician Evaluations"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Clinicians receive product samples and are <em>never compensated</em> to submit evaluations. <a href=\"#\">Learn more</a>"
    },
    {
      "type": "text",
      "id": "show_more_label",
      "label": "Show more",
      "default": "Show more"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more",
      "default": "Read more"
    },
    {
      "type": "textarea",
      "id": "powered_by",
      "label": "Powered by",
      "default": "Clinician reviews powered by <strong>frontrowMD</strong>"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "†This clinician wants to clarify that larger-scale research to support their product claims is still developing."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr. Suryadutt Venkat"
        },
        {
          "type": "text",
          "id": "credential",
          "label": "Credential",
          "default": "Verified clinician"
        },
        {
          "type": "text",
          "id": "initials",
          "label": "Initials",
          "default": "DA"
        },
        {
          "type": "image_picker",
          "id": "avatar_image",
          "label": "Avatar image"
        },
        {
          "type": "checkbox",
          "id": "use_initials",
          "label": "Use initials",
          "default": false
        },
        {
          "type": "text",
          "id": "specialty",
          "label": "Specialty",
          "default": "Family medicine"
        },
        {
          "type": "text",
          "id": "years",
          "label": "Years",
          "default": "26"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Natural ingredients help patients boost mental clarity and focus"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "<strong>Product reviewed: Zero Sugar Ashwagandha+ Gummies |</strong> Goli makes use of several adaptogens here (ashwagandha, L-Theanine, and maca root) that have been tested for their potential benefits on relaxation and mental clarity."
        },
        {
          "type": "text",
          "id": "highlight_1",
          "label": "Highlight 1",
          "default": "Increases focus"
        },
        {
          "type": "text",
          "id": "highlight_2",
          "label": "Highlight 2",
          "default": "Cognitive clarity"
        },
        {
          "type": "text",
          "id": "highlight_3",
          "label": "Highlight 3",
          "default": "Steady energy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Goli Editable Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Dr. Suryadutt Venkat",
            "credential": "Verified clinician",
            "initials": "SV",
            "use_initials": false,
            "specialty": "Family medicine",
            "years": "26",
            "title": "Natural ingredients help patients boost mental clarity and focus",
            "review": "<strong>Product reviewed: Zero Sugar Ashwagandha+ Gummies |</strong> Goli makes use of several adaptogens here (ashwagandha, L-Theanine, and maca root) that have been tested for their potential benefits on relaxation and mental clarity. For example, ashwagandha can support clearer thinking by helping the body manage stress-related hormones. L-Theanine can also soothe your mental state; however, it works by supporting the production of alpha waves in the brain, which can foster a sense of calm focus during work hours or as you relax in the evening. Maca root has also been researched for its ability to support energy, focus, and mental stamina. For patients, these ingredients can have a meaningful effect on mental clarity and focus, especially when they are struggling to cope with stress.†",
            "highlight_1": "Increases focus",
            "highlight_2": "Cognitive clarity",
            "highlight_3": "Steady energy"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Dr. Daniel Altman",
            "credential": "Verified clinician",
            "initials": "DA",
            "use_initials": true,
            "specialty": "Primary care",
            "years": "32",
            "title": "Ashwagandha mixes with vitamin D to improve sleep quality",
            "review": "<strong>Product reviewed: Zero Sugar Ashwagandha+ Gummies |</strong> I want to suggest this product for patients who have trouble settling down before bed. When you are feeling stressed during the day, the body releases a hormone called cortisol that can contribute to feelings of alertness, even at night. Ashwagandha may help modulate cortisol levels so that you can feel calm and fall asleep more easily. Vitamin D has a relationship to sleep as well. Though vitamin D is mostly used for the development of bones and teeth, it can also influence levels of serotonin, a neurotransmitter involved in sleep regulation. Early research suggests ashwagandha and vitamin D can both influence sleep quality, which is why these gummies can be impactful for patients with sleep troubles.†",
            "highlight_1": "Sleep support",
            "highlight_2": "Nighttime calm",
            "highlight_3": "Lower cortisol"
          }
        }
      ]
    }
  ]
}
{% endschema %}
