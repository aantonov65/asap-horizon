{{ 'lzy-sections.css' | asset_url | stylesheet_tag }}

<section class="lzy-goli-hero" data-lzy-section="goli-hero">
  <a class="lzy-goli-hero__link" href="{{ section.settings.section_link | default: '#product-target' }}">
    {% assign desktop_image = section.settings.desktop_image_url %}
    {% if section.settings.desktop_image != blank %}
      {% assign desktop_image = section.settings.desktop_image | image_url: width: 2400 %}
    {% endif %}
    {% assign mobile_image = section.settings.mobile_image_url %}
    {% if section.settings.mobile_image != blank %}
      {% assign mobile_image = section.settings.mobile_image | image_url: width: 900 %}
    {% endif %}
    <picture>
      <source media="(max-width: 767px)" srcset="{{ mobile_image }}">
      <img class="lzy-goli-hero__image" src="{{ desktop_image }}" alt="{{ section.settings.image_alt | escape }}" loading="eager" fetchpriority="high" width="2400" height="900">
    </picture>
  </a>
</section>

{% schema %}
{
  "name": "Goli Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop hero image"
    },
    {
      "type": "text",
      "id": "desktop_image_url",
      "label": "Desktop hero image fallback URL",
      "default": "https://goli.com/cdn/shop/files/EVERGREENQ12026-Home-DESKTOP.jpg?v=1771024138&width=5760"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile hero image"
    },
    {
      "type": "text",
      "id": "mobile_image_url",
      "label": "Mobile hero image fallback URL",
      "default": "https://goli.com/cdn/shop/files/EVERGREENQ12026-Home-MOBILE.jpg?v=1771024088&width=900"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Goli Zero Sugar Essentials bundle promotion"
    },
    {
      "type": "url",
      "id": "section_link",
      "label": "Hero link"
    }
  ],
  "presets": [
    {
      "name": "Goli Hero",
      "settings": {
        "desktop_image_url": "https://goli.com/cdn/shop/files/EVERGREENQ12026-Home-DESKTOP.jpg?v=1771024138&width=5760",
        "mobile_image_url": "https://goli.com/cdn/shop/files/EVERGREENQ12026-Home-MOBILE.jpg?v=1771024088&width=900",
        "image_alt": "Goli Zero Sugar Essentials bundle promotion",
        "section_link": "#product-target"
      }
    }
  ]
}
{% endschema %}
