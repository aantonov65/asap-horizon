{{ 'heresy-shared.css' | asset_url | stylesheet_tag }}
{{ 'heresy-layer-your-lips.css' | asset_url | stylesheet_tag }}
<script src="{{ 'heresy-layer-your-lips.js' | asset_url }}" defer></script>

<div data-heresy-section="{{ section.id }}">
<section class="heresy-layer-your-lips Highlights Section" data-heresy-layer-lips style="--heresy-layer-accent: {{ section.settings.accent }};">
  <div class="Highlights-images-container reverse-grid">
    <div class="heresy-layer-your-lips__slides" aria-live="polite">
      {% for block in section.blocks %}
        {% liquid
          assign fallback_asset = 'heresy-layer-shape.webp'
          if block.settings.fallback == 'flush'
            assign fallback_asset = 'heresy-layer-flush.webp'
          elsif block.settings.fallback == 'tint'
            assign fallback_asset = 'heresy-layer-tint.webp'
          endif
          assign defer_layer_image = false
          unless forloop.first
            assign defer_layer_image = true
          endunless
        %}
        <div class="swiper-slide{% if forloop.first %} heresy-is-active{% endif %}" data-heresy-layer-slide="{{ forloop.index0 }}">
          <div class="Highlights-image-container">
            <span class="Image Image--desktop o-placeholder bg-full-height skip-animation">
              {% render 'heresy-responsive-image', image: block.settings.image, fallback_asset: fallback_asset, alt: block.settings.image_alt, class: 'skip-animation heresy-layer-your-lips__image', width: 1120, height: 1222, sizes: '(max-width: 749px) 100vw, 50vw', defer_image: defer_layer_image %}
            </span>
            <div class="Highlights-image-dot Highlights-image-dot__active u-white u-noMargin" style="top: {{ block.settings.y }}%; left: {{ block.settings.x }}%;">
              <span class="Highlights-image-dot-dot"></span>
              <div class="u-pSize--Small">{{ block.settings.description }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="Highlights-wrapper">
    <div></div>
    <div class="Highlights-container">
      <h2 class="u-pSize__Medium u-bold u-noMargin">{{ section.settings.heading }}</h2>
      {% for block in section.blocks %}
        <button type="button" class="Highlights-toggle Highlights-toggle-wave{% if forloop.first %} Highlights-toggle__active{% endif %}" data-heresy-layer-toggle="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
          <svg viewBox="0 0 500 150" preserveAspectRatio="none" aria-hidden="true">
            <clipPath clipPathUnits="objectBoundingBox" id="heresy-layer-wave-{{ section.id }}-{{ block.id }}">
              <path d="M534.14,-27.11 C386.84,30.11 463.60,152.47 522.29,161.36 L0.00,150.00 L0.00,0.00 Z"></path>
            </clipPath>
          </svg>
          <h3 class="u-fontRektorat u-hSize--Medium Highlights-toggle-wave__primary"><span>{{ block.settings.title }}</span></h3>
          <h3 class="u-fontRektorat u-hSize--Medium Highlights-toggle-wave__secondary" aria-hidden="true" style="color: {{ section.settings.accent }}; clip-path: url(#heresy-layer-wave-{{ section.id }}-{{ block.id }});"><span>{{ block.settings.title }}</span></h3>
        </button>
      {% endfor %}
    </div>
    <div></div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Heresy layer lips",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "LAYER YOUR LIPS"},
    {"type": "color", "id": "accent", "label": "Accent", "default": "#b68574"}
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Layering step",
      "settings": [
        {"type": "text", "id": "title", "label": "Title", "default": "shape"},
        {"type": "richtext", "id": "description", "label": "Description", "default": "<p>Glide Peptide Lip Shape along the outline of your lips.</p>"},
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "image_alt", "label": "Image alt text", "default": "Layered lip routine"},
        {"type": "select", "id": "fallback", "label": "Bundled fallback", "options": [{"value": "shape", "label": "Shape"}, {"value": "flush", "label": "Flush"}, {"value": "tint", "label": "Tint"}], "default": "shape"},
        {"type": "range", "id": "x", "label": "Horizontal callout", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 60},
        {"type": "range", "id": "y", "label": "Vertical callout", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 72}
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Heresy layer lips",
      "blocks": [
        {"type": "step", "settings": {"title": "shape", "description": "<p>Glide Peptide Lip Shape along the outline of your lips.</p>", "fallback": "shape", "x": 60, "y": 72}},
        {"type": "step", "settings": {"title": "flush", "description": "<p>Tap on Pocket Blush to the center of your lips for creamy color.</p>", "fallback": "flush", "x": 51, "y": 67}},
        {"type": "step", "settings": {"title": "tint", "description": "<p>Swipe on Peptide Lip Tint for nourishing hydration and a hint of tint.</p>", "fallback": "tint", "x": 54, "y": 65}}
      ]
    }
  ]
}
{% endschema %}
