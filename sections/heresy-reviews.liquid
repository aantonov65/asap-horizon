{{ 'heresy-shared.css' | asset_url | stylesheet_tag }}
{{ 'heresy-reviews.css' | asset_url | stylesheet_tag }}

<div data-heresy-section="{{ section.id }}">
  <section class="heresy-reviews" aria-label="{{ section.settings.heading | escape }}">
    <header class="heresy-reviews__header">
      <div class="heresy-reviews__average">
        <strong>{{ section.settings.rating }}</strong>
        <span class="heresy-reviews__stars" aria-label="Rated {{ section.settings.rating }} out of 5 stars">★★★★★</span>
        <span>{{ section.settings.based_on }}</span>
      </div>
    </header>

    <div class="heresy-reviews__controls">
      <button type="button" class="heresy-reviews__filter" aria-label="Open review filters">
        <span aria-hidden="true">☷</span> {{ section.settings.filters_label }}
      </button>
      <label class="heresy-reviews__sort">
        <span class="visually-hidden">Sort reviews</span>
        <select aria-label="Sort reviews">
          <option>{{ section.settings.sort_label }}</option>
          <option>Oldest</option>
          <option>Most Helpful</option>
          <option>Photos &amp; Videos</option>
          <option>Highest Rating</option>
          <option>Lowest Rating</option>
        </select>
      </label>
    </div>

    <ol class="heresy-reviews__list">
      {% for block in section.blocks %}
        <li class="heresy-reviews__item" {{ block.shopify_attributes }}>
          <article class="heresy-reviews__review">
            <aside class="heresy-reviews__side">
              <div class="heresy-reviews__buyer">
                <strong>{{ block.settings.author }}</strong>
                {% if block.settings.verified %}<span>{{ section.settings.verified_label }} <span aria-hidden="true">●</span></span>{% endif %}
              </div>

              {% if block.settings.reviewing != blank %}
                <div class="heresy-reviews__detail">
                  <strong>{{ section.settings.reviewing_label }}</strong>
                  <a href="{{ product.url }}">{{ block.settings.reviewing }}</a>
                </div>
              {% endif %}

              {% if block.settings.recommended %}<p class="heresy-reviews__recommended">✓ {{ section.settings.recommended_label }}</p>{% endif %}

              <dl class="heresy-reviews__attributes">
                <div><dt>Age Range</dt><dd>{{ block.settings.age_range }}</dd></div>
                <div><dt>Biggest Skin Concern</dt><dd>{{ block.settings.concerns }}</dd></div>
                <div><dt>What is your skin type?</dt><dd>{{ block.settings.skin_type }}</dd></div>
                <div><dt>What are your favorite features about this product?</dt><dd>{{ block.settings.features }}</dd></div>
              </dl>
            </aside>

            <div class="heresy-reviews__main">
              <div class="heresy-reviews__topline">
                <span class="heresy-reviews__stars" aria-label="Rated {{ block.settings.rating }} out of 5 stars">{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</span>
                <span>{{ block.settings.date }}</span>
              </div>
              <h3>{{ block.settings.title }}</h3>
              <div class="rte heresy-reviews__body">{{ block.settings.body }}</div>

              <div class="heresy-reviews__ease">
                <strong>How easy is it to apply this product?</strong>
                <div class="heresy-reviews__scale" role="img" aria-label="Rated {{ block.settings.ease_rating }} on a scale of 1 to 5">
                  <span style="--heresy-review-score: {{ block.settings.ease_rating }};"></span>
                </div>
                <div class="heresy-reviews__scale-labels"><span>Not very easy</span><span>Super easy</span></div>
              </div>

              <footer class="heresy-reviews__helpful">
                <span>Was this helpful?</span>
                <button type="button" aria-label="Yes, this review was helpful">♕ 0</button>
                <button type="button" aria-label="No, this review was not helpful">♧ 0</button>
              </footer>
            </div>
          </article>
        </li>
      {% endfor %}
    </ol>

    <button type="button" class="heresy-reviews__more">{{ section.settings.more_label }}</button>
  </section>
</div>

{% schema %}
{
  "name": "Heresy reviews",
  "settings": [
    {"type": "text", "id": "heading", "label": "Accessible heading", "default": "Customer reviews"},
    {"type": "text", "id": "rating", "label": "Average rating", "default": "4.2"},
    {"type": "text", "id": "based_on", "label": "Review count text", "default": "Based on 2,387 reviews"},
    {"type": "text", "id": "filters_label", "label": "Filters label", "default": "FILTERS"},
    {"type": "text", "id": "sort_label", "label": "Default sort label", "default": "MOST RECENT"},
    {"type": "text", "id": "verified_label", "label": "Verified label", "default": "Verified Buyer"},
    {"type": "text", "id": "reviewing_label", "label": "Reviewing label", "default": "Reviewing"},
    {"type": "text", "id": "recommended_label", "label": "Recommended label", "default": "I recommend this product"},
    {"type": "text", "id": "more_label", "label": "Show more label", "default": "SHOW MORE"}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type": "text", "id": "author", "label": "Author", "default": "Mónica M."},
        {"type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true},
        {"type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5},
        {"type": "text", "id": "date", "label": "Date", "default": "Yesterday"},
        {"type": "text", "id": "title", "label": "Title", "default": "pretty"},
        {"type": "richtext", "id": "body", "label": "Body", "default": "<p>love this shade</p>"},
        {"type": "text", "id": "reviewing", "label": "Product reviewed", "default": "peptide lip shape lean"},
        {"type": "checkbox", "id": "recommended", "label": "Recommends product", "default": true},
        {"type": "text", "id": "age_range", "label": "Age range", "default": "25 - 34"},
        {"type": "text", "id": "concerns", "label": "Biggest skin concern", "default": "Uneven Skin Tone, Dry Lips"},
        {"type": "text", "id": "skin_type", "label": "Skin type", "default": "Combination"},
        {"type": "textarea", "id": "features", "label": "Favorite features", "default": "Defines Lips, Creamy Texture, Easy to Apply, Silicone Smudger"},
        {"type": "range", "id": "ease_rating", "label": "Ease of application", "min": 1, "max": 5, "step": 1, "default": 5}
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Heresy reviews",
      "blocks": [
        {"type": "review", "settings": {"author": "Mónica M.", "date": "Yesterday", "title": "pretty", "body": "<p>love this shade</p>", "reviewing": "peptide lip shape lean"}},
        {"type": "review", "settings": {"author": "Andjela V.", "date": "22 hours ago", "title": "the best!!", "body": "<p>i love that i can use it in combo with the pocket blush 💕 and twist is the best shade</p>", "reviewing": "peptide lip shape lean", "concerns": "Oily Skin", "features": "Enhances Lip Volume, Defines Lips, Creamy Texture, Easy to Apply, Smoothing"}}
      ]
    }
  ]
}
{% endschema %}
